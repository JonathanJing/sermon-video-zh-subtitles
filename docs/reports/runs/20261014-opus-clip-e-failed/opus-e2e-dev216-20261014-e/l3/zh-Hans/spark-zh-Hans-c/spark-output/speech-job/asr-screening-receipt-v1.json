  "results": [
    {
      "textGroupId": "translation-chunk-0005-u003",
      "targetTextSha256": "db74fa3c6811685eb86d22ed61446bdb31f8e4399c59890d81b65315db0892dc",
      "audioSha256": "1c7f32426939943c6be727a46dbc11de2e6c3d182b39e26515a87c889af533d5",
      "recognized": "出于他强烈这个核心特质，他做什么事都很强烈。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
