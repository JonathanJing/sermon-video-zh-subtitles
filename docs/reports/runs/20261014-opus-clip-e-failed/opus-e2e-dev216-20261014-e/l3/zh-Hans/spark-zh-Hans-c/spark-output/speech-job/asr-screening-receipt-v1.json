      "targetTextSha256": "3957c0fd860e3b8c40fc17286ad4e37638a488f9c1ddfc0426fc8571d2e52e58",
      "audioSha256": "784b2b2bd911d49a653515e223d8d1c4da820e55cd0b8117ee442327db174025",
      "recognized": "同样地，神出于他圣洁这一核心属性，他所做的一切都是以道德上完美的方式来做的。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u005",
      "targetTextSha256": "ec96ed2bd57ee03bf91e7a5103ca62ef8312a61b18ed449df0864cfb4735ed3b",
      "audioSha256": "1501ec7fb23635a60da229991e55d43ff28733ebe0d57d7367e2ff831157c06f",
      "recognized": "这就意味着，如果神要降下这些数天的警告，他会以怎样的方式来做呢？",
      "similarity": 0.965517,
      "differences": [
        {
