      "audioSha256": "4dfb75a4214c69781c9cc3b660e499d255d23d8a2a794c5e4c0db7dab910090b",
      "recognized": "但主就在他的圣殿里。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u015",
      "targetTextSha256": "33ee6e1b16061f55649f055c7b796c4bd74db268626c70320b4bd661bda4e62d",
      "audioSha256": "cf200b8def34fbd54d9334e80f773914164c99cf2af432d3f841381fdcc5fa70",
      "recognized": "全地都当在他面前静默。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u016",
