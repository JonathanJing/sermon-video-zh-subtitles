    },
    {
      "textGroupId": "translation-chunk-0005-u005",
      "targetTextSha256": "fc4cc43d9366acad7f7ca98c16490dd975a9b3f4c0bcc8163d5f823d5fdfa2ef",
      "audioSha256": "2f189c9ea063fbf058de64c52ff4f1f3a556cac4d80411e1b5beeeb325e98873",
      "recognized": "这也就是说，如果神带来这些神圣的警告，他会以怎样的方式来做呢？",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u006",
      "targetTextSha256": "aedab7893e28290288f53fa69b152d3cbb1ddacdba3e314c3422254063af5599",
      "audioSha256": "6d934af9cc3f84957b7c55711f276c4890695e0c7db9482061ac24d5dc5f2afd",
      "recognized": "以道德上完全无瑕的方式。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u007",
      "targetTextSha256": "fde3148c32a638c9f07755d787f58ba8655c40aeca515540a9973aa87d4527dd",
      "audioSha256": "de96ab91f4a4dc3fcbf3a299ec8ad458a403a99a5b430b290f2300de12547aec",
      "recognized": "所以我们看第八章时，实在令人惊叹的是，在神的警告，也就是浩筒的警告还没有发出之前。",
      "similarity": 0.972973,
      "differences": [
        {
          "kind": "replace",
          "expected": [
            "号"
          ],
          "recognized": [
            "浩"
          ]
        }
