      "audioSha256": "b7794f2c0f9dfe1166ce67a82793a2d776dbf4744096a2369f1197ca44e5a390",
      "recognized": "当他揭开第七个印的时候，天上安静了大约半个小时。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
