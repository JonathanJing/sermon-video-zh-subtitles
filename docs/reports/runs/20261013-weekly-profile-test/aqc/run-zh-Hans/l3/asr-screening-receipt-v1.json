    },
    {
      "textGroupId": "translation-chunk-0005-u008",
      "targetTextSha256": "3aed482cdc80c45fd10522d216738714f2ab334b923187996e5ccab6c0f80857",
      "audioSha256": "9150713e1f0913e444fd8c45d8106977c44841657dee99c13ab3c93edaa4ecfc",
      "recognized": "使徒约翰，也就是本书的作者，首先清楚地表明了神的圣洁。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u009",
      "targetTextSha256": "4a62e392a914e30576e3bf2d8cb2180bdf30bc20dc759b475b95540697fb9775",
      "audioSha256": "58dab3b35fdb55ce8d84db7eeb65a860a05e31200d264d97496834fbfd747de4",
      "recognized": "这在两个方面都令人惊叹。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u010",
      "targetTextSha256": "c84488d717a5ff165e0034fd22e5319829e24ef2c17d8d2dc6bfb26160c6e311",
      "audioSha256": "edc9ee426d1ea21158aecd49229112a4e90774924212ec2849f055494b92011b",
      "recognized": "第一是通过静默。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u011",
      "targetTextSha256": "a80ee073782390ff342e4fbc4d27a25ae95cdb836f38ed3eefd70682bdf43d84",
      "audioSha256": "42260738095a89055f9e8a39d7ebcb3beea0f23911e7fc95c8b5e3e6d9a1792d",
      "recognized": "静默。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u012",
      "targetTextSha256": "e9bbb5494f4b3914465b5c69fe2ea1efebe829d288280d6b3528f6048fde5f89",
      "audioSha256": "47aa66a122dcffe264eaf5f2c0264f84f135f22bb9cb1fa04774282b401f37a5",
      "recognized": "要知道，在旧约中，静默常常与神的圣洁联系在一起。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u013",
      "targetTextSha256": "d556d3d74a2d3a921728d7fb29709969196b4084728123b45e6b25842555710a",
      "audioSha256": "a5619d7ba687a460369e1da28dcaad1a3aa4b604bbf35117670b8a80ea6a274f",
      "recognized": "比如，我们来看《哈巴谷书》第二章。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u014",
      "targetTextSha256": "4af9002e2d4d00e601f1b0f2f2a72caa52043bc31ae0425cba60955a37e29a84",
      "audioSha256": "4df305acb562bcd5280758e0267238406a7c3d7c4526201e9c8b459c3f6233ae",
      "recognized": "但主在他的圣殿里。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u015",
      "targetTextSha256": "a25b4ee0d067ee8ca7bdd47f9ecfac052391e7cc29ccf944d7f1105ddacc3ccd",
      "audioSha256": "c89a607b0b40dfea3685bb4baa56f1def496c92f7e0d4aee627f4aa28b56d87b",
      "recognized": "全地都要在他面前保持安静。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u016",
      "targetTextSha256": "4b18e7a0d62508a53fd95e812809cc21f1fe9d7817d1a1579a15543bd090287c",
      "audioSha256": "ef8c42f1466fae8b5d26dd976ee3a20eaf9c914f39ecdf8ed3de4e207233b068",
      "recognized": "请注意第八章的第一节。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u017",
