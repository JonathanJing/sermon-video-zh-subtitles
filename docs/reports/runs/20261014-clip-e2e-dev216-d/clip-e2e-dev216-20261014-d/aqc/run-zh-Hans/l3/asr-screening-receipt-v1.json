      "audioSha256": "dfc355d8c740a42df3b148e3d8ee436d0f1da8742b4858fd5d70760fa30e13d3",
      "recognized": "当他揭开第七印的时候，天上寂静了大约半个小时。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
