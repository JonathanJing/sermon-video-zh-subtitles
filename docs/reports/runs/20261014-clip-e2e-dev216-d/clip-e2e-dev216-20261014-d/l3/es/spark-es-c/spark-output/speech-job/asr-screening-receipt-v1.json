      "status": "requires_review"
    },
    {
      "textGroupId": "translation-chunk-0005-u014",
      "targetTextSha256": "d2454af380ce648b060c82120c91aa5f6dc8a8db7b048e8851340d00a009f288",
      "audioSha256": "77260625bd5c8f2af2c5d473f698e2176916c6f7848de079df7a0e8a0f9400a9",
      "recognized": "Pero el señor está en su santo templo.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u015",
      "targetTextSha256": "ce2a0ef13f6de93c0feed865f5c05e3a472f563eed1365e57483f508a5c39713",
      "audioSha256": "8422c11ad87b756959568c08ba1f777063ee9fcb9900688f59a09178095f8ac8",
      "recognized": "Que toda la tierra guarde silencio en su presencia.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u016",
      "targetTextSha256": "d7952b966ef2beab2a65a9e0d6cc6eeaac0393bc288e658d7e86786fdecd3f95",
      "audioSha256": "d0b77f2a72669c956741e57d41e62e51aa9970bda75e84d9e151b618d721541d",
      "recognized": "Fíjense en el primer versículo del capítulo ocho.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u017",
      "targetTextSha256": "2c9d1ee3cf63f7ec91f9d7942ea9faac38bb141c7423c71750e0d6083b4c4ebf",
      "audioSha256": "f9839ea9fe4aa73afbd39a224c7778ae00337b283b125f42dd371b4db086075a",
      "recognized": "Cuando él abrió el séptimo sello, hubo silencio en el cielo durante aproximadamente media hora.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
