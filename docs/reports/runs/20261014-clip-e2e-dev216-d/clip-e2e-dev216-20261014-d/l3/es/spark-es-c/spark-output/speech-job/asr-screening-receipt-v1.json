  "results": [
    {
      "textGroupId": "translation-chunk-0005-u003",
      "targetTextSha256": "d23bb6fe1b069aa1850add4cb28f2510af900afdb4c810a25da3bc4e57902891",
      "audioSha256": "578101b5519c99d31301ea67b2e9b283303ce05e1292339de77bd257d8873241",
      "recognized": "A partir de su atributo esencial de intensidad, él lo hace todo intensamente.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u004",
      "targetTextSha256": "b51756644b11a2a739298f5a24a4bff925d61f1566f19e793a805476f99e3856",
      "audioSha256": "b5d32e870855b059d451711bec5af665784a59196a21648b2e72eddcbf3c7bcf",
      "recognized": "Y así, de la misma manera, Dios, en virtud de su atributo esencial de santidad, hace todo de una manera moralmente perfecta.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u005",
      "targetTextSha256": "513f45c84eed04ce1836f10a02dff56f8fb21ec953eaefc4085bb667a4fb54a0",
      "audioSha256": "795499ff63b3b60466084514c313b7a4f524ea8b9593fc04e8b240ad0d355ed7",
      "recognized": "Lo que significa que si Dios lleva a cabo estas advertencias divinas, cómo lo haría",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u006",
      "targetTextSha256": "8a6effae78037a93e76d376e4cb397fdb214dee7a9770ad87866338e5309c5a4",
      "audioSha256": "4f4e3468ada78e38152fa0598e8bee13ed46a0bccc2f0b5f1e9bd11f4908c7e3",
      "recognized": "De una manera moralmente perfecta.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u007",
      "targetTextSha256": "d246a41ceb1214a120fa8120a8a2867135e5fcca0b9fc106ae2df4f1b467ed98",
      "audioSha256": "dc73238a3a7c05e15477594623f21c9fdbd07527d0bd695018a8bf8076e738c9",
      "recognized": "Por eso es tan increíble que cuando examinamos el capítulo ocho antes de que siquiera se den las advertencias divinas las advertencias de las trompetas.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u008",
      "targetTextSha256": "7835cca02d6ae65c951f5f0eb41399f46a0458ecb4e6d44e0e36067f1e5fb980",
      "audioSha256": "4f7ddf889eca4c913e217f494d381544d3a0582ffd5d994fec48fac848e092bc",
      "recognized": "El apóstol Juan, el autor primero establece claramente la santidad de Dios.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u009",
      "targetTextSha256": "f4684f90c8d75b61531dfefdb83d23610ef51b826ad672bcd71b2175057f13a2",
      "audioSha256": "04ed5b2085070bc84f67b32d7ac65cc5f8616939cf3a203813f2ec4481b520e6",
      "recognized": "Es increíble de dos maneras.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u010",
      "targetTextSha256": "14a1acc31e4eb2d931283220773de4e6e746b186ae6f8359a96e7b8adc60d226",
      "audioSha256": "fd6c9cc7e123331c20563328b28312ee8cdd8c6721060fac8ac9155e94981612",
      "recognized": "Primero, a través del silencio.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u011",
      "targetTextSha256": "bf38e201c2494b68db28363300a6b763fe8389967f24a106bd8d8082b4b124fc",
      "audioSha256": "32d8d8a75b1df270fe01cb6ef8572388971c87307d650f9a1eedc45dd885aef1",
      "recognized": "Silencio.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u012",
      "targetTextSha256": "bf1152304b79c3a77f57e575a3fc05a4c09debb5c51fe2d152ecd6803c4931f5",
      "audioSha256": "44961bdc278305edf90e698e6eff98e0d33dfe539ed3b99d5ce40b547e82b7dc",
      "recognized": "Saben, en el Antiguo Testamento a menudo hay una conexión entre el silencio y la santidad de Dios.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u013",
      "targetTextSha256": "f6d15bdbf1f7150646a0c9e3b5c46415a6b2cc4108e079b8a5621bf126f94ab4",
      "audioSha256": "86a12a3a49ab1a5c6675ab02cd7b17397e4f5a6897d84842f7f6416b42794d9d",
      "recognized": "Por ejemplo, miren Habakkuk dos.",
      "similarity": 0.8,
      "differences": [
        {
          "kind": "replace",
          "expected": [
            "habacuc"
          ],
          "recognized": [
            "habakkuk"
