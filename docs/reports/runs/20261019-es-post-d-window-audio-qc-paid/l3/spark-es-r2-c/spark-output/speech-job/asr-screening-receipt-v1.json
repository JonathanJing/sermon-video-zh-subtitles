  "results": [
    {
      "textGroupId": "translation-chunk-0005-u003",
      "targetTextSha256": "efb4b9a363f9ef7d45614d6959ca43473070a3c9ac2049be7c08d375f9aa105b",
      "audioSha256": "604f77f8dc580267c2cf49faad4acc37c2d842f577473f30ee0f47b1854e53f0",
      "recognized": "A partir de su atributo central que es la intensidad, él hace todo con intensidad.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u004",
      "targetTextSha256": "cb572145628a27536b36c56a7ea4e50794dca20b09fbca325c1a43584c8b8f3a",
      "audioSha256": "f78c8ccb48250b7ee40d73cc6cfde97365504016a86d5f4ee11a9469d67d3336",
      "recognized": "Y así, de la misma manera, Dios a partir del atributo esencial de la santidad lo hace todo de una manera moralmente perfecta.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u005",
      "targetTextSha256": "a4ee95d9912597ccafe1c75b005c98551fd0dd5ca8b70f4d014a5ca0c29a5abc",
      "audioSha256": "15b363898150a4700fded34094021ef69177c7c608ec830380a86fbfbda0ecd1",
      "recognized": "Lo cual significa que si Dios trae estas advertencias divinas, cómo lo haría",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u006",
      "targetTextSha256": "8a6effae78037a93e76d376e4cb397fdb214dee7a9770ad87866338e5309c5a4",
      "audioSha256": "fe59ec39e63b77881682a4b9174aa4f4731ebf080b401960d60fca82478ea0e6",
      "recognized": "de una manera moralmente perfecta.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u007",
      "targetTextSha256": "530a84d52eca2f44f2a2676c8427f8713220f2384244de4b2853db6607bb9522",
      "audioSha256": "7b93c747b4be26433deeee5648dde948db07a12cd1cc0af3533eb66ea3a80ede",
      "recognized": "Por eso es tan increíble que cuando miramos el capítulo 8 antes de que se den siquiera las advertencias divinas, las advertencias de las trompetas.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u008",
      "targetTextSha256": "a3d7430fec2fbd5e181e2d02ab62dc4982720232a1284053cce9add73356b189",
      "audioSha256": "c8ae1ea081967d0b574be19dd60f5d62ac5f0cf587f46586ffb78872c604492d",
      "recognized": "El apóstol Juan, el autor, primero establece claramente la santidad de Dios.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u009",
      "targetTextSha256": "f4684f90c8d75b61531dfefdb83d23610ef51b826ad672bcd71b2175057f13a2",
      "audioSha256": "82c885e545e5185e8b837b1f18ca55577ceefe255a1e6a2553ab622771b98f7e",
      "recognized": "Es increíble de dos maneras.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u010",
      "targetTextSha256": "75365cbf2381a42afe32699747109591101b7f2dce9834364cd892c0d08758af",
      "audioSha256": "9ec3e235c1b71418db5d982e0b117d6e235c310a5218a7cebef6a5920e2efe05",
      "recognized": "Primero por medio del silencio.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u011",
