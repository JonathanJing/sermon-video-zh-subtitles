      "audioSha256": "b32c196cc3c079955d9d25cad79e3552f39c5be9de1c2b1065c87d11b4099b07",
      "recognized": "所以神在他们的额上盖了印。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u316",
      "targetTextSha256": "91711cef46bfce3f94b501019072259045e35aec0b9f87a6292a6bcb758b6b81",
      "audioSha256": "408e57980fd27bd39b4cc87edf5681be1e147e7dce425add5d340e461bdb13bd",
      "recognized": "他带来审判，但他拯救数他自己的人。",
