      "audioSha256": "ea5704072a7c5f2951d02754c651f5a6512dc9d3e1efe7d6bf32317bc6a62f51",
      "recognized": "你继续往下读圣经。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u310",
