      "audioSha256": "2fc199007ac59ba34897943446276ff6f930ffbff6fb9069eec2aa2e5cd97ef4",
      "recognized": "是的，他要审判巴比伦。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u319",
      "targetTextSha256": "639970c9c5687bdb3c3ebb6932df6faf4d11b5445cdfb985f4f31922d8856777",
      "audioSha256": "a35377f0316ffe825ff6b67430bf0802c70a649285a286182033fa7096ec340f",
      "recognized": "我们盼望这个世界并不是一切。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u320",
      "targetTextSha256": "af9d3e1f8ff52701fb8c46032a2c88fda2148efcb5fe201310c13ad1e2803c65",
      "audioSha256": "a1b932a33ec9c7be7985e9daf3b84ddc0aebf38d6b864cd4e7b289d5a8a65d14",
      "recognized": "我们想要永生，我们是属于他的。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u321",
      "targetTextSha256": "3b97e0d8ebbe3e74bf59b02b87d9714f4162eec2c32fd40e1d8205700238ec9f",
      "audioSha256": "191b09fa25a07ed596f37c140098e92b2fe2118e80458bf85a6417d4f9083353",
      "recognized": "我们已经受了印记。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u322",
      "targetTextSha256": "6156be83d6cb34361fa3f546bfe125a70a1780392b1df487a7fc2610c1bb14c5",
      "audioSha256": "c1e46c2c9aacb8730b69540fe48f81e400f9155820d29278458a359963311225",
      "recognized": "我们会经历试炼。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u323",
      "targetTextSha256": "f3905ba70503adcc1b8ea647af779d915b479d69d59655fab7721663908e24fe",
      "audioSha256": "6fdaa1ea7ecb8393198e273ca9fc91b5233be9419164a06a594a20da94bbdd1b",
      "recognized": "我们会经历苦难，但我们永远不会与他隔绝，因为他保守我们，归于他自己。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u324",
      "targetTextSha256": "be32ca808e1fd389635d3ead4d6b67d72a74bf1ca3dcc6d68bad6012edb6d4f1",
      "audioSha256": "127e712a92c8e7e95cc653e426ca185e318f9344c76ab9894c6f7dc7ce96cbbb",
      "recognized": "而你，如果你已经信了他，听着，你在这世上会受苦。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u325",
      "targetTextSha256": "04e86e1244a165fa53ff12e4f15db81ef0aa8604dd557f51f7a97f8909b9f17b",
      "audioSha256": "e5d13f91812e5e53dc5cc61b0fd10ab939dfea68e55685d6c2557bf61908229a",
      "recognized": "但是没有任何苦难能使你与神的爱隔绝。这爱是在我们的主基督耶稣里的。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u326",
      "targetTextSha256": "31ebac26c4254d99ec8256911a287001f75a284c67c6919de98dfa6a2e6c5053",
      "audioSha256": "67f3a715ef69aef7b1cf4de45c49b502cd37ead939406cc19a4cc1c8d3b0d532",
      "recognized": "没有任何试炼能使你与他隔绝。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u327",
      "targetTextSha256": "8ce9f4f9ca65b91be30a700b955433f2dc0eda801d3908ca73c445a05a35a200",
      "audioSha256": "5aa960169b0c708861d8fb670ddde096cee55ac3812ac3ad545f10ac9335a311",
      "recognized": "他把数他的人保守在自己身边。",
      "similarity": 0.923077,
