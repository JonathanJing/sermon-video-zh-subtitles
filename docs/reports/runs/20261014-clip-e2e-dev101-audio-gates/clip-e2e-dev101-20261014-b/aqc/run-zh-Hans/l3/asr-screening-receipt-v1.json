      "targetTextSha256": "317333e780ed53f37a408c48331a55dcacaa020b4422f76c888e2529e49214ba",
      "audioSha256": "133a2605ac9ab3309fd87e8ddba59f61333f8225f3958b091e2b14cb221bf98c",
      "recognized": "接着，第六号带来的灾难非常惨烈。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0002-u019",
