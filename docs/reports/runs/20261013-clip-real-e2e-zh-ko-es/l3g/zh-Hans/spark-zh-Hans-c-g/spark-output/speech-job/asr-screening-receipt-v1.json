      "audioSha256": "f4854207e77a2f66a1a474108a5157308126081a170b07cc8e47b48920ddcba7",
      "recognized": "比如我们来看看《哈巴谷书》第二章。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u014",
