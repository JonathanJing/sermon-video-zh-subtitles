      "audioSha256": "feb60e17ffdf57e3217a01392e3e53d13eae33e231bf9cf9ad2459c10d7658e3",
      "recognized": "这在两个方面都令人惊叹。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u010",
      "targetTextSha256": "c84488d717a5ff165e0034fd22e5319829e24ef2c17d8d2dc6bfb26160c6e311",
      "audioSha256": "d5266625921c26591515cc2cb2ebebf40182a3c1ffb6937dade526ca0f1c9a65",
      "recognized": "第一，是通过静默。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u011",
