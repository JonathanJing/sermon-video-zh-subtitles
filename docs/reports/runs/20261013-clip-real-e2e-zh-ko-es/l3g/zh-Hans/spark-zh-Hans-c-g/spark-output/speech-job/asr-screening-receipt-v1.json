      "audioSha256": "edc86064b0dfa1f635e1996abb9fac00325d101eaf4d13c55620883e70d85062",
      "recognized": "但主在他的圣殿里。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u015",
