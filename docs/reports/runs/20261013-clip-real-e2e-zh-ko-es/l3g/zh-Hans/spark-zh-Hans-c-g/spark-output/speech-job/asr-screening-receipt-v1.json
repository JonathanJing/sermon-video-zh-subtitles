      ],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u008",
      "targetTextSha256": "0318c04ed199a2d2a9e3d05c4875024a67d5b87b132c1770d46e8e660b7060a6",
      "audioSha256": "4cdb312e85bc5cc08b0eb236c107f03de8d0f00bce9c0abdaa1792f2a8f1f56a",
      "recognized": "身为作者的使徒约翰，首先清楚地阐明了神的圣洁。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u009",
