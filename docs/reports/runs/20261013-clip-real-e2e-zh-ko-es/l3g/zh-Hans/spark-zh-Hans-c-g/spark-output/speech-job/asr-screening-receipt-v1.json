      "audioSha256": "c965e3085a09aaaa9022e6aac9396f5f4cc5a3b8ed09d3c4c2c9d05005909120",
      "recognized": "静默。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u012",
      "targetTextSha256": "8c9ca8be0e18ca38fd5d4e54a82792631c666107b5ed7170beac8c9203bb27eb",
      "audioSha256": "a977efa9f4a03f6a42ef734fd62cf2f5bb433fd212da015ac5367230dfe60e41",
      "recognized": "大家知道，在旧约中，静默常常与神的圣洁联系在一起。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u013",
