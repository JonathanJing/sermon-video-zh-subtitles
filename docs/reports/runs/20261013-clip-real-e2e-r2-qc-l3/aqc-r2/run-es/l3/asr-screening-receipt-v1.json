      "audioSha256": "0a017592c15c9a16b7570828c3ec3531f155426dcedc9a6aa0d6612f52335b2f",
      "recognized": "Por eso es tan increíble que cuando vemos el capítulo 8 antes de que se den siquiera las advertencias divinas, las advertencias de las trompetas.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
