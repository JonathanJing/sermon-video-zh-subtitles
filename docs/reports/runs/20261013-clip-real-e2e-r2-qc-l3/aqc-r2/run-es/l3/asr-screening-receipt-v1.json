      "audioSha256": "22a511aae236eb18d97fd878fdac802739042eac9d1cf44d6cda2a95670ec60f",
      "recognized": "Juan, el apóstol y autor, establece primero con claridad la santidad de Dios.",
      "similarity": 1.0,
      "differences": [],
