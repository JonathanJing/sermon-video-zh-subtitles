      "audioSha256": "7778a48c0ad626572cce7014fc5136c85500529e8d100acac280bb12f128a3d3",
      "recognized": "Lo cual significa que si Dios lleva a cabo estas advertencias divinas, cómo lo haría",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
