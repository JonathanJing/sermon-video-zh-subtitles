      "audioSha256": "caef898abfa46afacc70de00c5eee44446c01c45524f7ef01864babcc72d3027",
      "recognized": "以道德上完美无瑕的方式。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u007",
