      "audioSha256": "f79a44a930a965c422be5a19f17a445320a9caddd539f49617414bd6464996e8",
      "recognized": "使徒约翰，也就是本书的作者，首先清楚地表明了神的圣洁。",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
