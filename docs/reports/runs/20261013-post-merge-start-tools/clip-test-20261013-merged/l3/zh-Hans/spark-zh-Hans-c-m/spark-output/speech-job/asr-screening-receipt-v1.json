    {
      "textGroupId": "translation-chunk-0005-u005",
      "targetTextSha256": "d70c00f63fa76ada6bb8c95cc75b9febad3d4376b9745493b72d2a9bb8dc2a1d",
      "audioSha256": "57d65e021894db5460f4d1971d8a38e1970e5ba4864b155d91a278a683d15518",
      "recognized": "这就意味着，如果神让这些神圣的警告临到，他会以怎样的方式来做呢？",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
