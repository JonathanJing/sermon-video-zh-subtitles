  "results": [
    {
      "textGroupId": "translation-chunk-0005-u003",
      "targetTextSha256": "b34d05b7a037759575fa0faa5a6aecbb473671625c66389f7df16e8af6f70660",
      "audioSha256": "d9fcdc002138d7e81b132cfe5a15515d697549a195febb6dcab2d684668cfda7",
      "recognized": "Debido a su atributo esencial de intensidad, él lo hace todo intensamente.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u004",
      "targetTextSha256": "c997e65830f7f32a96bb7588be49dcd22d71a583a997a5af35627b3f98ac57c2",
      "audioSha256": "b4aeb8a441fa0769a68962097fbcb6235e94b4d08441efbc9100a9247ede4d56",
      "recognized": "Y así, de la misma manera, Dios, en virtud de su atributo fundamental de santidad, hace todo de una manera moralmente perfecta.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u005",
      "targetTextSha256": "4147e4d146d70bc7594df77743f942bc0230e53ce9d89a4b0be19161b8c86571",
      "audioSha256": "c1dc43f7074642d0432af80ba835325a5a5c0c2be2e738f6aca1082b07fe13db",
      "recognized": "Lo que significa que si Dios hace que se produzcan estas advertencias divinas, cómo lo haría",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u006",
      "targetTextSha256": "8a6effae78037a93e76d376e4cb397fdb214dee7a9770ad87866338e5309c5a4",
      "audioSha256": "717ba3f043c1c5bcdd90bb839e958463e9e8aa871ab3ab1ae6c27f8816e90c81",
      "recognized": "De una manera moralmente perfecta.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u007",
      "targetTextSha256": "e74f7e4d08a450347c2ab7ec0ca817b418a7e1f89d178fe88c3323901f62274e",
      "audioSha256": "b8c42cc7ffdebe1ca9b4d734ed7363a92718a367f66dc14394a1c00956f34192",
      "recognized": "Por eso es tan increíble que cuando examinamos el capítulo 8 antes de que se den las advertencias divinas las advertencias de las trompetas.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u008",
      "targetTextSha256": "a8e0b66525e9d0a9c69c21cf26d4ab918b7eb37c12e5eeac8fbd326f88c7ae37",
      "audioSha256": "4dccae00a053b806711cb11f2ae2b8226fa83ba061cc0c8d82bbd714e4b98a40",
      "recognized": "El apóstol Juan, el autor, establece primero con claridad la santidad de Dios.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u009",
      "targetTextSha256": "27a695ccf6d09ab63f00ecae2188d574e94404bb0e76a3cd8443b19a212fc98e",
      "audioSha256": "919935c8753bbe8e592a97c0909f3da6b45f7041122614b7fec68946cf494ad8",
      "recognized": "Es increíble en dos sentidos.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u010",
      "targetTextSha256": "14a1acc31e4eb2d931283220773de4e6e746b186ae6f8359a96e7b8adc60d226",
      "audioSha256": "90ba25df4fd814b1beb2af448eef94f8ac8f38ef1991fac35b80c732a4e67667",
      "recognized": "Primero, a través del silencio.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u011",
      "targetTextSha256": "bf38e201c2494b68db28363300a6b763fe8389967f24a106bd8d8082b4b124fc",
      "audioSha256": "32d8d8a75b1df270fe01cb6ef8572388971c87307d650f9a1eedc45dd885aef1",
