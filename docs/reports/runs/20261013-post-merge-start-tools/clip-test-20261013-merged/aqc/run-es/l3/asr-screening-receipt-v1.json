    },
    {
      "textGroupId": "translation-chunk-0005-u012",
      "targetTextSha256": "bf1152304b79c3a77f57e575a3fc05a4c09debb5c51fe2d152ecd6803c4931f5",
      "audioSha256": "44961bdc278305edf90e698e6eff98e0d33dfe539ed3b99d5ce40b547e82b7dc",
      "recognized": "Saben, en el Antiguo Testamento a menudo hay una conexión entre el silencio y la santidad de Dios.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-chunk-0005-u013",
      "targetTextSha256": "f6d15bdbf1f7150646a0c9e3b5c46415a6b2cc4108e079b8a5621bf126f94ab4",
      "audioSha256": "86a12a3a49ab1a5c6675ab02cd7b17397e4f5a6897d84842f7f6416b42794d9d",
      "recognized": "Por ejemplo, miren Habakkuk dos.",
