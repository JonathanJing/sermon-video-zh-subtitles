    {
      "textGroupId": "translation-0-u319",
      "targetTextSha256": "61af7ba89386e843998893d850f23bdb123cade9267c73587e103f1a1a3ae18b",
      "audioSha256": "c5afd0235a8768aa4988ba73a14cf9b658751399513ef4e443cdc5589f061fb2",
      "recognized": "Queremos que este mundo no sea todo lo que hay.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u320",
      "targetTextSha256": "1c1723d1cf97772c8083887182974a85631809269bcde895958beeefee9df8b0",
      "audioSha256": "226d5f09dd182a3dd702b4efd549e8d6884fd2d8ccb4118a5226edab7460d2a2",
      "recognized": "Queremos la vida eterna y le pertenecemos a él.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u321",
      "targetTextSha256": "66cf5ab72fc3061f7adee0cd3c230b00e5f7451d8bfa2ea3a2f341be88b0aa45",
      "audioSha256": "f382254064a095ccbd469c98bb447c7c31a7998b41c675a621e55ff6ae399735",
      "recognized": "Estamos sellados.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u322",
      "targetTextSha256": "4553956b5690056deb7f37cdbc3ad4f0f9615fa55fcc812d3ff6aa81f7a72f22",
      "audioSha256": "95e13c74137ed9aa51fcab479576ff5eb72afa113435dbe32e7ba70cdf8cdec8",
      "recognized": "Vamos a pasar por pruebas.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u323",
      "targetTextSha256": "f070934f2fd8866194d02a8f034782a5630c65642ea1d194002af9cf41daab80",
      "audioSha256": "df94c7ce374203438cd7b3ed24201d174560aa30c73c11e8f526b232c5621fa2",
      "recognized": "Vamos a pasar por sufrimiento, pero nunca seremos separados de él porque él nos guarda para sí mismo.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u324",
      "targetTextSha256": "0e00bd9f815bc950befc1dcfc4b5de58dc645b9ca7fdef1923725b103dd02d0c",
      "audioSha256": "f34b550ff48eb8d4b7f55779df067656e2c022b0d524decc0089ac5f320e5945",
      "recognized": "Y tú si has creído en él, escucha, vas a sufrir en este mundo.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u325",
      "targetTextSha256": "afa63747152875056d495675a6086800f00064cb735e81fde8e153697af9d6b7",
      "audioSha256": "f7430868294631e9a7ede8399419504e8be392d321219271f3feec2bc6d87039",
      "recognized": "Pero no hay sufrimiento que te vaya a separar del amor de Dios que está en Cristo Jesús nuestro Señor.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u326",
      "targetTextSha256": "f24c37f6fae6a10c48284524451de437e72db977ac388889f4161256ad81fdbc",
      "audioSha256": "d24586d7cd125f0726af778ed3802c38e744ceb06815f7caed6033788c6df468",
      "recognized": "No hay prueba que te separe de él.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u327",
      "targetTextSha256": "b765f0978168e9f93b6697506cffd166ced13846d58f4ee469a43d1da6d9aeb4",
      "audioSha256": "8b287fca3f7355f1b79a15a39d305b3373537bb073cac99ad0193788d3992f30",
      "recognized": "Él guarda a los suyos para sí mismo.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u328",
      "targetTextSha256": "5e98519cc1ce7a2e94b33c54427088217368929c93c15025c5717f2d29a301f7",
      "audioSha256": "00a7f6d0517080f4c3a80d898773156741c60c46bcab85314e82ffaf1d993dfd",
      "recognized": "Estás sellado.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u329",
      "targetTextSha256": "5c99bb83bb7eead3bf5ebf35a7cf62c3b3a77271910c87a8333fa84912520565",
      "audioSha256": "8a996b433e8585215cc6398dce5cb9d16f71bae4f95832cad4951d63ecb6892e",
      "recognized": "Él te sostiene.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u330",
      "targetTextSha256": "bdde3e78ab579da6213304e729774d2865fc58485e9b5454d479e025bd7ccc47",
      "audioSha256": "5a03c1cd55abdb008bb2acff341768d07f76ea57ca1ede39309dd99b88ed14c9",
      "recognized": "Él te protege porque eres suyo.",
