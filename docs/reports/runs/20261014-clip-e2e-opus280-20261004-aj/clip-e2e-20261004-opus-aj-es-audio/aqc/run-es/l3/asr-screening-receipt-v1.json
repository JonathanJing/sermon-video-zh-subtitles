    },
    {
      "textGroupId": "translation-0-u296",
      "targetTextSha256": "b0e27bee79d436b09aa438b78213d47cbfe61cb1987db7d9e907b5a721553c04",
      "audioSha256": "ad051d66aac4d4945a08583bbf980def793aa903fe39b5cefb99bd204d6fb26a",
      "recognized": "Sé que estoy hablando rápido, pero escuchen rápido.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u297",
      "targetTextSha256": "ce3b16a17382e6f1b93dc3a5307c48279985751f799051b096cde02527a3068b",
      "audioSha256": "be6b1754e99413f1caeb87af100d24e88ff0fa8fabf3a27a61c2db600b2c8d13",
      "recognized": "Dios trae juicio sobre la ciudad de Jericó, era una ciudad pecadora y Dios va a juzgar.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u298",
      "targetTextSha256": "39897b0fc0c0c3048782eb21f0174f79e64b048a84895085978f60bbe541da1e",
      "audioSha256": "14dace50229d464329a6c6f90348c4f13b83a99d78ecea425c3f62a629faa9b3",
      "recognized": "pero aún así Dios guarda a una persona para sí mismo",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u299",
      "targetTextSha256": "9a00479a1f5a71542da5f69d51098a3a5842f28f75d96f9e01ca83bc39ac9a0c",
      "audioSha256": "72af295fe7f90b99b9fe59c776d537b12adc0c26c3282138e445542e95d68aa3",
      "recognized": "Se llama Rajab y él no la guarda para sí porque ella haya sido extraordinaria porque haya sido fiel.",
      "similarity": 0.947368,
      "differences": [
        {
          "kind": "replace",
          "expected": [
