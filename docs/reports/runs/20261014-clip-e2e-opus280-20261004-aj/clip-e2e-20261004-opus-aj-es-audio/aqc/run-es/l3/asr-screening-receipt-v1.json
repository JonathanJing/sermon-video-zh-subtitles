    {
      "textGroupId": "translation-0-u311",
      "targetTextSha256": "2f72bbad4e35ed033fe0e20a4302dabb1556a9eb4ced46381b5eb5fab9ef3339",
      "audioSha256": "98151799e7ad8a37339292699eede037d189e51dbbea38a56d94ea4d71959d89",
      "recognized": "Esta historia es menos conocida, pero en el libro de Ezekiel está el pueblo de Dios, y Dios de hecho va a juzgar a su propio pueblo porque tiene tanto pecado en la tierra.",
      "similarity": 0.970588,
