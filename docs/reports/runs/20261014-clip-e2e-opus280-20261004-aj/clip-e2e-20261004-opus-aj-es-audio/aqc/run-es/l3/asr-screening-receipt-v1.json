      "recognized": "ella es una prostituta",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u302",
      "targetTextSha256": "21adc399a58a6b7ee58debeeace33ab2e9629b48c7579f30c7d03d3b18819e9c",
      "audioSha256": "dc0620d715343335fc1a206478e5af6bf8323b628861eb9d212d483287dcca62",
      "recognized": "Pero ella cree en él.",
      "similarity": 1.0,
      "differences": [],
