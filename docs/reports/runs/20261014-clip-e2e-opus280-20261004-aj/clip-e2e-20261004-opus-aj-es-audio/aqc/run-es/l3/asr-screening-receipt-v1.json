    },
    {
      "textGroupId": "translation-0-u312",
      "targetTextSha256": "552bc203a560dfa5c92c0e4bf3a5cf7e57ae4ea92efedce8db9a000c0061d3a3",
      "audioSha256": "44e466ba473e44cf5cbf700ee7db286f8455f8a275d706edc3b161d9ac312ebc",
      "recognized": "Pero hay un remanente, un grupo de personas que dice: \"No queremos el pecado en nuestra tierra\".",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u313",
      "targetTextSha256": "4a8fa5e3f5262bf483e974bad8aa3d4eee2b78751ca49d1c9cfd303b66e4bbd0",
      "audioSha256": "f6f607d344615fd77a362dcbeb88058535efdd952f95036fb534941ca79ddfba",
      "recognized": "Lo que queremos es tu Dios.",
      "similarity": 0.833333,
      "differences": [
        {
          "kind": "replace",
