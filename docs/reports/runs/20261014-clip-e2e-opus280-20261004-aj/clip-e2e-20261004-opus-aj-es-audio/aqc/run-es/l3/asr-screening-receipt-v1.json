  "results": [
    {
      "textGroupId": "translation-0-u281",
      "targetTextSha256": "811fd8d59cae59ee4d2bb62a8c052598901f4ecd62993868dc42404509d3362c",
      "audioSha256": "f50b2fb412ad0249cab528de1f53c54233ac9040e49c3e14e866b01468a09a18",
      "recognized": "La última plaga fue la más severa.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u282",
      "targetTextSha256": "fca2bd33c33d1c9eaa0c52c265934de167d09a062fe58029bbc4f9ee1716ffeb",
      "audioSha256": "4b67a8ad762129a31c29ceec14b706d2af41faa5ba3b3f77bd6dcbf50d6bae5d",
      "recognized": "Se trataba de que el ángel de la muerte iba a pasar por todo Egipto y el primogénito de cada hogar iba a ser muerto.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u283",
      "targetTextSha256": "6c087b37229504475d6b3c3d7821dfcbd732e956ced144b16f41378069068ee2",
      "audioSha256": "c3dc50002ad460396fee68daffd0fa040f34aa8c28ebf86a223003fa7d89147a",
      "recognized": "Pero entonces Dios le dice a su propio pueblo: oigan, escuchen, esto es lo que deben hacer.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u284",
      "targetTextSha256": "21a43a507d537440967f3fb433ffdcf84bfdea4f9e1606a21ec44f03dfe88ede",
      "audioSha256": "49b7b2612e38ca9e585e1f66e8bc305948aa020424b1247c1eb8b3401862431b",
      "recognized": "Tomen un cordero, sacrifiquen el cordero, tomen la sangre del cordero y ponganla en el marco de la puerta.",
      "similarity": 0.947368,
      "differences": [
        {
          "kind": "replace",
          "expected": [
            "pónganla"
          ],
          "recognized": [
            "ponganla"
          ]
        }
      ],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u285",
      "targetTextSha256": "46d6032515e27b2db15876b5281f058d72de8ca01bcdf910ea461fa5d8ae5b2d",
      "audioSha256": "8f7f294909491d17cfc2e6506fe69aea2183491ed8cb10106f2349b0ee6f27b3",
      "recognized": "Y la sangre del cordero en el marco de la puerta va a ser una marca distintiva que muestra que ustedes me pertenecen, que son míos.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u286",
      "targetTextSha256": "0a60acff0c7cc28fefd9dc5aa9267259857da6f9f61dd1223c92513420e0a939",
      "audioSha256": "3566b3df96cdab2fdc8dc09bda451c821d171db4f5f05cbdc5e04da259a84b26",
      "recognized": "Y eso fue lo que hizo el pueblo de Dios, y fueron sellados y fueron protegidos a través del juicio.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u287",
      "targetTextSha256": "9346d781c3009f8f40968e5fe6928ae2723363d309a33a4d51e00a57100124d3",
      "audioSha256": "57e5f248ea19ad9c1bff2000c78a1e6626f3c889a3984863cd723d08e5a66adb",
      "recognized": "Así que hay juicio, pero Dios guarda a su pueblo para sí mismo.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u288",
      "targetTextSha256": "ceb4465375452f929fadee452afafb682ae61bc10391ee68982db44bbc263b74",
      "audioSha256": "b0bbf071a521d884a57b32e231e2e9098e6a947b9da13bcc6863fcd69ca6e6cf",
      "recognized": "Y ahora nosotros, aquí hoy los que somos cristianos, no tenemos la sangre de corderos en los postes de nuestras puertas.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u289",
      "targetTextSha256": "3b40fb5b1cf94d983c34484a0c3f1c5bc2c54fc8c50a5577e702b47581926877",
      "audioSha256": "b50a219bf9cfa312cc4fb5bb362daedda7ed6b5c977ec3949bca9defa8bd7948",
      "recognized": "Tenemos la sangre de Jesucristo, el cordero de Dios que cubre nuestra vida.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u290",
      "targetTextSha256": "f122b3ac70de59c5141f0d2d9c4d1e081a9256cd72a525cf9644bef469145de3",
      "audioSha256": "a5de62bd1d4804b00eb16b2fe6d478580e1a4131bae5ffd6f19c9931b07ec727",
      "recognized": "Estamos sellados gracias a Jesús, el cordero que fue sacrificado por nosotros.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u291",
      "targetTextSha256": "66cf5ab72fc3061f7adee0cd3c230b00e5f7451d8bfa2ea3a2f341be88b0aa45",
      "audioSha256": "369cffb5c0d75878918549d5dc1ec569ee905f15afe5733fe44ef44b434cf18f",
      "recognized": "Estamos sellados.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u292",
      "targetTextSha256": "2cff81753e7255092d9c928ab59d0483eb47afcb0c93c106fc03963393f7446d",
      "audioSha256": "60ea0ffec64d985c525ec47e182b86ae51023f6cafa2495d1167ae4222e1e35a",
      "recognized": "Sigues leyendo el Antiguo Testamento.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u293",
      "targetTextSha256": "da21e26a5153964ba9f186663171c468f6857d29be57b392d56ebd9fd859cd08",
      "audioSha256": "a72016aafa368759099f5a65a75d5ebcdbfce09c03e4c18f3991551983e820b5",
      "recognized": "Ustedes llegan a la siguiente parte de la historia de Dios con su pueblo, y el pueblo de Dios entra en la tierra prometida.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u294",
      "targetTextSha256": "a5f12760f3fe864f868b59b8243456d05a376be91dd58c5117e296869060b078",
      "audioSha256": "255e6ae272d6b7074c150142220a1391d20831c4136ae1b36fd6bf78da610b72",
      "recognized": "La primera ciudad en la tierra prometida es la ciudad de Jericó.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u295",
      "targetTextSha256": "de5a765a95babe29111b10e23539ccfcc3883b6198298242da4b43fc3a5fba65",
      "audioSha256": "f47468218e044682ef4adfb607b195a6d255358f3d046ef3437ca796a5ee6b30",
      "recognized": "Y si recuerdan, Dios trae juicio sobre Jerico.",
      "similarity": 0.875,
      "differences": [
        {
          "kind": "replace",
          "expected": [
            "jericó"
          ],
