    },
    {
      "textGroupId": "translation-0-u314",
      "targetTextSha256": "4acfa754d93034730239db503c9ec6b636bc0b807a44072f706f8e07a7c97821",
      "audioSha256": "2d9051919e2d9b8642ff51a5601c4a7a5ec6d12fcd42b964bc3d88f671eedfae",
      "recognized": "Te somos fieles.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u315",
      "targetTextSha256": "d6360ed7d482a36d8a344c55d55dd68ae6fdc8ecf4ece93b54a8d1d90152350c",
      "audioSha256": "9442db0bc6ce374e0569b3dc28cf83de1edd2f589bfb569fd49399dd91714244",
      "recognized": "Y así Dios los sella en la frente.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u316",
      "targetTextSha256": "e0d496434e5ad077f0af049d11980832b654bde63264b41ad75f938c1644d4c3",
      "audioSha256": "e28780f79c19b0d7703e4c8f5b43ce02b1664c219b8a74709a1a09af97bbd246",
      "recognized": "El trae juicio pero rescata a los suyos.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u317",
      "targetTextSha256": "81b08636ab899f616cc574d591550fbc36464a8ba461ff538d5433be1e4d931c",
      "audioSha256": "29df5df1ecd336f4ce0af2406d9a47e9fa28ab9cab6065271bdc3bb5e869c468",
      "recognized": "Y así los primeros oyentes cuando leían Apocalipsis 6 y 7 sé que puede sonar muy intenso pero los primeros cristianos decían",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u318",
      "targetTextSha256": "444595a460284bda08f7e7e0949379f1f44cc1d04287b27efc3e305e25aaff7f",
      "audioSha256": "d12b5090ed41a88512b1e8578b8dd3981c58821895b7ebb0c14f52933a75a58f",
      "recognized": "Si él va a juzgar a Babylonia.",
      "similarity": 0.857143,
      "differences": [
        {
          "kind": "replace",
