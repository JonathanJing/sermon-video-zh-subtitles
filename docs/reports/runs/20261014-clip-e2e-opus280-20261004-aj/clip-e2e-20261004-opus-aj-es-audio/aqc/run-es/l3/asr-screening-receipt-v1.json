      "audioSha256": "135aca8a5180e09878cc1bc24aad6dd82c82561a54058711ec22d5cb95545d2d",
      "recognized": "Y así Dios la recibe consigo, la hace suya y la sella.",
      "similarity": 1.0,
      "differences": [],
      "status": "pass"
    },
    {
      "textGroupId": "translation-0-u306",
