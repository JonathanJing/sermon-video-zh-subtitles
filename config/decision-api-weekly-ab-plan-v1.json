    "expansion": {
      "targetCasesPerStageOrSubtask": 200,
      "sampleSizeRequiresPairedPowerAnalysis": true,
      "minimumExtendedClipSeconds": 600,
      "fullLengthCanaryRequired": true
    }
  },
  "timing": {
    "unit": "milliseconds_for_decisions_seconds_for_human_and_resolution",
    "clock": "monotonic_for_local_durations_UTC_for_durable_calendar",
    "fields": [
      "sharedUpstreamSeconds",
      "evidencePreparationMs",
      "queueWaitMs",
      "decisionCallMs",
      "postprocessValidationMs",
      "effectiveDecisionMs",
      "humanActiveSeconds",
      "humanWaitSeconds",
      "repairComputeSeconds",
      "reworkCount",
      "resolutionWallSeconds",
      "experimentCalendarSeconds"
    ],
    "perCallTimeoutSeconds": 120,
