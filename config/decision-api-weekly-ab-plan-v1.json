    "humanActivePerCaseCensorSeconds": 600,
    "fullTrackReviewCensoredByThisLimit": false,
    "restorationUsesOriginalTiming": true,
    "missingTimingValue": null,
    "stageWindowsArePredictions": false,
    "observationWindowMeaning": "first_observation_block_not_batch_deadline"
  },
  "decisionRule": {
    "criticalErrorsAllowed": 0,
    "noninferiorityAccuracyDifferenceLower95Ci": -0.03,
    "noninferiorityCriticalRecallDifferenceLower95Ci": -0.02,
    "targetRelativeReduction": 0.2,
    "requiresEquivalentTaskForReplacement": true,
    "clusterBootstrap": true,
    "multipleClaimsCorrection": "Holm_or_explicit_exploratory",
    "allowedConclusions": [
      "A_wins",
      "B_wins",
      "hybrid_candidate",
      "inconclusive",
      "no_executable_baseline",
      "not_contract_equivalent"
    ],
    "noninferiorityEstimator": "preregistered_non_degenerate_paired_proportion_score_or_exact_with_cluster_assumptions",
    "degenerateBootstrapCannotEstablishNoninferiority": true,
    "insufficientEffectiveClustersConclusion": "inconclusive",
    "primaryTimeMetricsChosenBeforeHoldout": true
