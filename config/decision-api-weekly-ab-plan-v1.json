        "ko",
        "es"
      ],
      "strataTargets": {
        "normal": 12,
        "real_failure": 12,
        "difficult_or_quotation": 12,
        "insufficient_evidence": 12,
        "boundary_or_confusable": 12
      },
      "verdictType": "exploratory"
    },
    "latencyPanel": {
      "holdoutCasesPerStage": 10,
      "pairedRepeatsPerCase": 3,
      "repeatsIncreaseQualityN": false
