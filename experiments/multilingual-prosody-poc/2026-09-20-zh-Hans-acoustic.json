  "sentences": [
    {
      "sourceUnitId": "block-59-u001",
      "phrases": [
        {"phraseId": "p01", "targetText": "看似失败的事，其实是耶稣在战胜我们的仇敌，因为他是那位胜过一切的。", "sourceWordRange": ["block-59-w0001", "block-59-w0021"], "instruct": "Speak more slowly and deliberately while remaining natural."}
      ]
    },
    {
      "sourceUnitId": "block-59-u002",
      "phrases": [
        {"phraseId": "p01", "targetText": "他胜过一切。", "sourceWordRange": ["block-59-w0022", "block-59-w0025"], "instruct": "以坚定、有力的重复语气朗读，重读‘胜过一切’；不增加或删除文字。"}
      ]
    },
    {
      "sourceUnitId": "block-59-u003",
      "phrases": [
        {"phraseId": "p01", "targetText": "你有一个", "sourceWordRange": ["block-59-w0026", "block-59-w0027"], "instruct": "以直接提醒听众的证道语气朗读；不增加或删除文字。"},
        {"phraseId": "p02", "targetText": "仇敌，是一头", "sourceWordRange": ["block-59-w0028", "block-59-w0032"], "instruct": "自然承接上文，清楚读出‘仇敌’，句意尚未结束；不增加或删除文字。"},
        {"phraseId": "p03", "targetText": "吼叫的狮子。", "sourceWordRange": ["block-59-w0033", "block-59-w0034"], "instruct": "带警告感朗读，重读‘吼叫的狮子’并自然收句；不增加或删除文字。"}
      ]
    },
    {
      "sourceUnitId": "block-59-u004",
      "phrases": [
        {"phraseId": "p01", "targetText": "正伺机", "sourceWordRange": ["block-59-w0035", "block-59-w0036"], "instruct": "以克制但有警示感的语气朗读；不增加或删除文字。"},
        {"phraseId": "p02", "targetText": "毁灭你，吞吃你。", "sourceWordRange": ["block-59-w0037", "block-59-w0042"], "instruct": "清楚、有力度地朗读，重读‘毁灭’和‘吞吃’，自然收句；不增加或删除文字。"}
      ]
    },
    {
      "sourceUnitId": "block-59-u005",
      "phrases": [
        {"phraseId": "p01", "targetText": "但", "sourceWordRange": ["block-59-w0043", "block-59-w0043"], "instruct": "短促、有转折感地朗读‘但’；不增加或删除文字。"},
        {"phraseId": "p02", "targetText": "下周我们讲到", "sourceWordRange": ["block-59-w0044", "block-59-w0053"], "instruct": "以自然、连贯的预告语气朗读；不增加或删除文字。"},
        {"phraseId": "p03", "targetText": "《启示录》第4章和第5章时，", "sourceWordRange": ["block-59-w0054", "block-59-w0058"], "instruct": "清楚朗读经卷名与章节，保持证道语气；不增加或删除文字。"},
        {"phraseId": "p04", "targetText": "就会看到耶稣被称为", "sourceWordRange": ["block-59-w0059", "block-59-w0062"], "instruct": "带逐步揭示的语气朗读，轻微重读‘耶稣’；不增加或删除文字。"},
        {"phraseId": "p05", "targetText": "犹大支派的狮子，", "sourceWordRange": ["block-59-w0063", "block-59-w0069"], "instruct": "坚定而有宣告感地朗读，重读‘犹大支派的狮子’；不增加或删除文字。"}
      ]
    },
    {
      "sourceUnitId": "block-59-u006",
      "phrases": [
        {"phraseId": "p01", "targetText": "而他的吼声", "sourceWordRange": ["block-59-w0070", "block-59-w0072"], "instruct": "坚定朗读，重读‘吼声’，自然承接上一句；不增加或删除文字。"},
        {"phraseId": "p02", "targetText": "压倒了", "sourceWordRange": ["block-59-w0073", "block-59-w0073"], "instruct": "短促有力地朗读，强烈重读‘压倒了’；不增加或删除文字。"},
        {"phraseId": "p03", "targetText": "撒但的吼声。", "sourceWordRange": ["block-59-w0074", "block-59-w0075"], "instruct": "以得胜的结论语气朗读，重读‘撒但’和‘吼声’并自然收句；不增加或删除文字。"}
      ]
    }
  ]
