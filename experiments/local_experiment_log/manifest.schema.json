{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "evidence_kind",
    "duration_mode",
    "duration_seconds",
    "layer_component_mapping",
    "admission_design_reference",
    "artifact_return_reference"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "local.experiment.manifest.v1"
      ]
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_kind": {
      "enum": [
        "real",
        "synthetic",
        "replay"
      ]
    },
    "duration_mode": {
      "enum": [
        "fixed_sample",
        "wall_budget"
      ]
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "layer_component_mapping": {
      "type": "object",
      "minProperties": 1
    },
    "required_layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "L1",
          "L2",
          "L3",
          "L4"
        ]
      }
    },
    "admission_design_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifact_return_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
