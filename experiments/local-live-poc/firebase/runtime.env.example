# Copy to runtime.env after provisioning the Firebase dev project.
# runtime.env is ignored by Git and loaded automatically by sunday-live.sh.
LOCAL_LIVE_FIREBASE_DATABASE_URL="https://DATABASE_INSTANCE.firebaseio.com"
LOCAL_LIVE_FIREBASE_VIEWER_URL="https://PROJECT_ID.web.app"

# Recommended: mint short-lived credentials without a downloaded JSON key.
LOCAL_LIVE_FIREBASE_IMPERSONATE_SERVICE_ACCOUNT="caption-publisher@PROJECT_ID.iam.gserviceaccount.com"

# Keep the public stream slower than the local display to control bandwidth.
LOCAL_LIVE_FIREBASE_PARTIAL_INTERVAL_MS="500"
LOCAL_LIVE_FIREBASE_SESSION_TTL_SECONDS="14400"
