{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JonathanJing/sermon-video-zh-subtitles/experiments/sentence-first-agent/pages/page-config.schema.json",
  "title": "Sentence-first page publish config",
  "description": "One file per published page; sfa_publish.py reads it. Unknown keys are rejected so a misspelled constant fails before assets are written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pageId",
    "environment",
    "locales",
    "defaultTargetLocale",
    "runsRoot",
    "runs",
    "source",
    "sentences",
    "speakers",
    "category",
    "title",
    "meta",
    "verdict",
    "candidate",
    "audioPackage",
    "releasePackageId",
    "verify",
    "englishReference"
  ],
  "properties": {
    "schemaVersion": { "const": "sentence-first-page-config-v1" },
    "pageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "environment": { "enum": ["dev", "production"] },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["zh-Hans", "ko", "es"] }
    },
    "defaultTargetLocale": { "enum": ["zh-Hans", "ko", "es"] },
    "runsRoot": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "date", "window", "englishSource"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "englishSource": { "type": "string", "minLength": 1 }
      }
    },
    "sentences": { "type": "integer", "minimum": 1 },
    "speakers": { "type": "string", "minLength": 1 },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "labels"],
      "properties": {
        "schemaVersion": { "const": "sermon-page-display-category-v1" },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "meta": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "series", "scripture", "badge", "source", "note"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "series": { "type": "string", "minLength": 1 },
          "scripture": { "type": "string", "minLength": 1 },
          "badge": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verdict": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "translationBasis"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "translationBasis": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "approved": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "audioPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "voices", "synchronization"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "voices": {
          "oneOf": [
            { "const": "from-speakers" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "synchronization": { "type": "string", "minLength": 1 }
      }
    },
    "releasePackageId": {
      "type": "string",
      "minLength": 8,
      "pattern": "\\{pageId\\}",
      "description": "Python format template with {pageId}, {locale}, {environment}."
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion"],
      "properties": { "schemaVersion": { "type": "string", "minLength": 1 } }
    },
    "englishReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["full", "clip"] } }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "includeEnvironment": { "type": "boolean" } }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "allowDefaultLocaleDrift": { "type": "boolean" } }
    },
    "mediaType": { "enum": ["podcast", "clip"] },
    "sourceMode": { "enum": ["single_source"] },
    "titleCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["englishTitle", "mode"],
      "description": "Title-table check: titles must come from docs/series-sermon-titles.zh.md, or be explicitly frozen under a recorded reason.",
      "properties": {
        "englishTitle": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["table", "published", "approved_exception"] },
        "seriesKey": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "publishedTitles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 }
      }
    }
  }
}
