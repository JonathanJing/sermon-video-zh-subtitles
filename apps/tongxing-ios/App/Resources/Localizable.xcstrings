    "AI 合成中文配音与整理文字 · 独立个人项目": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-synthesized Chinese audio and AI-prepared text · an independent personal project"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI로 합성한 중국어 오디오와 정리한 텍스트 · 개인 독립 프로젝트"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio en chino sintetizado por IA y texto preparado por IA · proyecto personal independiente"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh tiếng Trung tổng hợp bằng AI và văn bản do AI biên soạn · dự án cá nhân độc lập"
          }
        }
