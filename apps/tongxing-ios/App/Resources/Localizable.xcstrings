    "App 已进入后台，听声对齐已停止。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app entered the background. Audio alignment stopped."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 백그라운드로 전환되어 소리 정렬이 중지되었습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app pasó a segundo plano. Se detuvo la alineación de audio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đã chuyển sang nền. Căn chỉnh âm thanh đã dừng."
          }
        }
      }
    },
    "一起听懂，一路同行。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand together. Walk together."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 이해하고 함께 걸어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprendamos juntos. Caminemos juntos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng thấu hiểu, cùng đồng hành."
          }
        }
      }
    },
