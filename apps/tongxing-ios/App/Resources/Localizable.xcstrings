{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "当前中文版本": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Chinese version"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 중국어 버전"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión actual en chino"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản tiếng Trung hiện tại"
          }
        }
      }
    },
    "所选语言在独立发布页面中打开；原生播放器继续保留当前已验证的中文音轨。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected language opens on its own release page. The native player keeps the currently verified Chinese track."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 언어는 별도의 공개 페이지에서 열립니다. 앱 플레이어는 현재 확인된 중국어 오디오를 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma elegido se abre en su propia página publicada. El reproductor conserva la pista en chino verificada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ đã chọn mở trong trang phát hành riêng. Trình phát vẫn giữ bản âm thanh tiếng Trung đã xác minh."
          }
        }
      }
    },
    "选择证道语言": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose sermon language"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설교 언어 선택"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir idioma del sermón"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngôn ngữ bài giảng"
          }
        }
      }
    },
    "尚无可选择的语言版本": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No language versions available"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택할 수 있는 언어 버전이 없습니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay versiones en otros idiomas"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có phiên bản ngôn ngữ nào để chọn"
          }
        }
      }
    },
    "发布目录尚未提供已人工审核的目标语言。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The release catalog does not yet contain a human-reviewed target language."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시 목록에 사람이 검토한 대상 언어가 아직 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El catálogo aún no tiene idiomas revisados por una persona."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục phát hành chưa có ngôn ngữ đích được người duyệt."
          }
        }
      }
    },
    "证道语言": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sermon language"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설교 언어"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma del sermón"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ bài giảng"
          }
        }
      }
    },
    "选择后打开该语言自己的已发布页面。界面语言和证道音频语言不会被静默更改。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection opens that language's published page. The interface and sermon audio languages are never changed silently."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 언어의 공개 페이지가 열립니다. 앱 인터페이스와 설교 오디오 언어는 자동으로 바뀌지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección abre la página publicada de ese idioma. El idioma de la app y del audio no cambian automáticamente."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn sẽ mở trang phát hành của ngôn ngữ đó. Ngôn ngữ ứng dụng và âm thanh bài giảng không tự thay đổi."
          }
        }
      }
    },
