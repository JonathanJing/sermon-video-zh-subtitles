{
  "name": "dsh-production-progress",
  "version": "0.1.0",
  "private": true,
  "description": "DSH dock row for sentence-first production status (journal-derived snapshots)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "UNLICENSED"
}
