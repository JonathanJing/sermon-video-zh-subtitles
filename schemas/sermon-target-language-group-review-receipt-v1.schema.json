{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-target-language-group-review-receipt-v1.schema.json",
  "title": "One human translation-group decision with a conservative block context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sourceLocale", "targetLocale", "englishSourcePackageJsonSha256",
    "anchorManifestJsonSha256", "translationPolicySha256", "originCandidateJsonSha256",
    "translationGroupId", "groupReviewJsonSha256", "contextScope", "contextEvidence",
    "contextGroupIds", "contextJsonSha256",
    "decision", "evidence", "reviewer", "reviewedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "sermon-target-language-group-review-receipt-v1" },
    "sourceLocale": { "const": "en" },
    "targetLocale": { "type": "string", "pattern": "^(?!en(?:-|$))[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "englishSourcePackageJsonSha256": { "$ref": "#/$defs/sha256" },
    "anchorManifestJsonSha256": { "$ref": "#/$defs/sha256" },
    "translationPolicySha256": { "$ref": "#/$defs/sha256" },
    "originCandidateJsonSha256": { "$ref": "#/$defs/sha256" },
    "translationGroupId": { "type": "string", "minLength": 1 },
    "groupReviewJsonSha256": { "$ref": "#/$defs/sha256" },
    "contextScope": { "enum": ["whole_candidate", "connected_blocks"] },
    "contextEvidence": { "type": ["string", "null"] },
    "contextGroupIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "contextJsonSha256": { "$ref": "#/$defs/sha256" },
    "decision": { "enum": ["approved", "rejected"] },
    "evidence": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
