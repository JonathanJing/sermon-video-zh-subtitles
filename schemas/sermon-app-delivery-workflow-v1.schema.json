{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-app-delivery-workflow-v1.schema.json",
  "title": "Explicit App bundle producer configuration; no model or publisher commands",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sunday", "plan", "jobRoot", "outputDirectory"],
  "properties": {
    "schemaVersion": {"const": "sermon-app-delivery-workflow-config-v1"},
    "sunday": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "plan": {"$ref": "#/$defs/path"},
    "jobRoot": {"$ref": "#/$defs/path"},
    "outputDirectory": {"$ref": "#/$defs/path"}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*://).+"}
  }
}
