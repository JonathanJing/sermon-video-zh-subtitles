{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-unified-job-v1.schema.json",
  "title": "Unified production job",
  "description": "One admitted unit of work inside a run. The same record is used for every layer. This schema is not loaded by a production command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "productionRunId",
    "runRevision",
    "jobRoot",
    "layer",
    "stageId",
    "locale",
    "scope",
    "subject",
    "identity",
    "attempt",
    "state",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schemaVersion": { "const": "sermon-unified-job-v1" },
    "jobId": { "type": "string", "minLength": 1 },
    "productionRunId": { "type": "string", "minLength": 1 },
    "runRevision": { "type": "integer", "minimum": 1 },
    "jobRoot": { "type": "string", "minLength": 1 },
    "layer": { "enum": ["layer1", "layer2", "layer3", "layer4", "outline", "reflection"] },
    "stageId": { "$ref": "#/$defs/stageId" },
    "locale": { "oneOf": [{ "$ref": "#/$defs/targetLocale" }, { "type": "null" }] },
    "scope": { "$ref": "#/$defs/completionScope" },
    "subject": { "$ref": "#/$defs/subject" },
    "identity": { "$ref": "#/$defs/identity" },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": { "$ref": "#/$defs/dimensions" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
  },
  "allOf": [
    { "if": { "properties": { "stageId": { "enum": ["media_verify", "window_review", "asr", "english_source"] } }, "required": ["stageId"] }, "then": { "properties": { "layer": { "const": "layer1" } } } },
    { "if": { "properties": { "stageId": { "enum": ["layer2_admit", "layer2_group", "translation_review"] } }, "required": ["stageId"] }, "then": { "properties": { "layer": { "const": "layer2" } } } },
    { "if": { "properties": { "stageId": { "enum": ["layer3_prepare", "layer3_unit", "layer3_screen", "listen_review"] } }, "required": ["stageId"] }, "then": { "properties": { "layer": { "const": "layer3" } } } },
    { "if": { "properties": { "stageId": { "const": "study_product" } }, "required": ["stageId"] }, "then": { "properties": { "layer": { "enum": ["outline", "reflection"] } } } },
    { "if": { "properties": { "stageId": { "const": "publish_endpoint" } }, "required": ["stageId"] }, "then": { "properties": { "layer": { "const": "layer4" } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetLocale": { "type": "string", "pattern": "^(?!en(?:-|$))[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "stageId": {
      "enum": [
        "media_verify",
        "window_review",
        "asr",
        "english_source",
        "layer2_admit",
        "layer2_group",
        "translation_review",
        "layer3_prepare",
        "layer3_unit",
        "layer3_screen",
        "listen_review",
        "study_product",
        "publish_endpoint"
      ]
    },
    "completionScope": {
      "enum": [
        "media_verified",
        "english_ready_for_translation",
        "layer2_machine_candidate",
        "translation_approved",
        "audio_screened",
        "listen_approved",
        "study_approved",
        "dev_reader_verified",
        "dual_test_end_approved",
        "dual_production_verified"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["stage", "locale", "group", "unit", "endpoint", "product"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputDigest", "contractVersion", "operation"],
      "properties": {
        "inputDigest": { "$ref": "#/$defs/sha256" },
        "contractVersion": { "const": "sermon-unified-job-v1" },
        "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "artifact", "review", "publication", "device"],
      "properties": {
        "process": { "enum": ["not_started", "running", "succeeded", "failed", "blocked", "waiting_reconciliation", "cancel_requested", "cancelled"] },
        "artifact": { "enum": ["not_started", "present_unverified", "verified", "missing", "incompatible"] },
        "review": { "enum": ["not_required", "machine_pending", "human_pending", "approved", "rejected", "waived"] },
        "publication": { "enum": ["not_applicable", "not_started", "assets_deployed", "http_verified", "partial", "failed"] },
        "device": { "enum": ["not_checked", "not_run", "passed", "failed"] }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "sha256"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/artifactKind" },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "locale": { "oneOf": [{ "$ref": "#/$defs/targetLocale" }, { "type": "null" }] },
        "packageStatus": { "type": "string", "minLength": 1 }
      }
    },
    "artifactKind": {
      "enum": [
        "media_identity",
        "english_source_package",
        "english_source_review",
        "target_language_candidate",
        "target_language_group_review",
        "target_language_human_review",
        "speech_job",
        "target_language_audio_package",
        "target_language_audio_screening",
        "target_language_audio_human_review",
        "study_product",
        "release_package",
        "release_receipt",
        "catalog"
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "locale": { "oneOf": [{ "$ref": "#/$defs/targetLocale" }, { "type": "null" }] },
        "artifactId": { "type": ["string", "null"] }
      }
    }
  }
}
