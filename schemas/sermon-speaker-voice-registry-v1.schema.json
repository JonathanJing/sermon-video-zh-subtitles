{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-speaker-voice-registry-v1.schema.json",
  "title": "Speaker Voice Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "baseModel", "supportedTargetLocales", "speakers"],
  "properties": {
    "schemaVersion": { "const": "sermon-speaker-voice-registry-v1" },
    "registryId": { "type": "string", "minLength": 1 },
    "baseModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "revision"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "supportedTargetLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/locale" }
    },
    "speakers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speakerId", "displayName", "speakerKey", "checkpoint", "authorization", "localeCapabilities"],
        "properties": {
          "speakerId": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "speakerKey": { "type": "string", "minLength": 1 },
          "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkpointRef", "checkpointSha256", "trainingStatus", "trainingReceipt"],
            "properties": {
              "checkpointRef": { "type": "string", "pattern": "^speaker-voice://" },
              "checkpointSha256": { "$ref": "#/$defs/sha256" },
              "trainingStatus": { "enum": ["training_smoke_completed", "production_admitted"] },
              "trainingReceipt": { "type": "string", "minLength": 1 }
            }
          },
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "purposes", "evidence"],
            "properties": {
              "status": { "enum": ["missing", "authorized", "revoked"] },
              "purposes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["chinese_dubbing", "multilingual_voice_demo", "multilingual_dubbing"] }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "localeCapabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["targetLocale", "modelLanguage", "status", "demoStatus", "reviewEvidence"],
              "properties": {
                "targetLocale": { "$ref": "#/$defs/locale" },
                "modelLanguage": { "type": "string", "minLength": 1 },
                "status": { "enum": ["unverified_poc", "candidate", "human_reviewed", "unsupported"] },
                "demoStatus": { "enum": ["not_generated", "generated", "machine_screened", "human_reviewed", "rejected"] },
                "adapterOverride": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["adapter", "model", "revision", "conditioningRef"],
                  "properties": {
                    "adapter": { "enum": ["gwen_tts_zero_shot_reference"] },
                    "provider": { "type": "string", "minLength": 1 },
                    "model": { "type": "string", "minLength": 1 },
                    "revision": { "type": "string", "minLength": 1 },
                    "conditioningRef": { "type": "string", "pattern": "^speaker-reference://" }
                  }
                },
                "reviewEvidence": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
  }
}
