{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-formal-dev-content-v1.schema.json",
  "title": "Hash-bound reviewed sermon text for the formal Dev player",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "sourceLocale", "locale", "englishSourcePackageJsonSha256", "targetLanguageCandidateJsonSha256", "targetLanguageAudioPackageJsonSha256", "contentStatus", "audioStatus", "series", "title", "speaker", "scripture", "date", "summary", "durationSeconds", "cues", "outline"],
  "properties": {
    "schemaVersion": { "const": "sermon-formal-dev-content-v1" },
    "pageId": { "type": "string", "minLength": 1 },
    "sourceLocale": { "const": "en" },
    "locale": { "type": "string", "minLength": 2 },
    "englishSourcePackageJsonSha256": { "$ref": "#/$defs/sha256" },
    "targetLanguageCandidateJsonSha256": { "$ref": "#/$defs/sha256" },
    "targetLanguageAudioPackageJsonSha256": { "$ref": "#/$defs/sha256" },
    "contentStatus": { "const": "human_reviewed" },
    "audioStatus": { "const": "human_reviewed" },
    "series": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "speaker": { "type": "string", "minLength": 1 },
    "scripture": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "cues": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["start", "end", "text", "textGroupId", "sourceUnitIds"],
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "textGroupId": { "type": "string", "minLength": 1 },
          "sourceUnitIds": { "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "outline": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false,
        "required": ["title", "body"],
        "properties": { "title": { "type": "string", "minLength": 1 }, "body": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
