{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-target-language-audio-human-review-receipt-v2.schema.json",
  "title": "Full audio and 1x video review with explicit ASR adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetLocale", "englishSourcePackageJsonSha256", "targetLanguageCandidateJsonSha256", "targetLanguageAudioPackageJsonSha256", "trackSha256", "machineScreeningStatus", "machineScreeningReceiptJsonSha256", "asrAdjudications", "decision", "reviewedBy", "reviewedAt", "fullPlayback", "videoSync1x", "reviewedUnitIds", "checks", "issues"],
  "properties": {
    "schemaVersion": { "const": "sermon-target-language-audio-human-review-receipt-v2" },
    "targetLocale": { "type": "string", "minLength": 2 },
    "englishSourcePackageJsonSha256": { "$ref": "#/$defs/sha256" },
    "targetLanguageCandidateJsonSha256": { "$ref": "#/$defs/sha256" },
    "targetLanguageAudioPackageJsonSha256": { "$ref": "#/$defs/sha256" },
    "trackSha256": { "$ref": "#/$defs/sha256" },
    "machineScreeningStatus": { "enum": ["pass", "requires_review"] },
    "machineScreeningReceiptJsonSha256": { "$ref": "#/$defs/sha256" },
    "asrAdjudications": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["textGroupId", "decision", "evidence"],
      "properties": {
        "textGroupId": { "type": "string", "minLength": 1 },
        "decision": { "const": "approved" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    } },
    "decision": { "const": "approved" },
    "reviewedBy": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "fullPlayback": { "const": "approved" },
    "videoSync1x": { "const": "approved" },
    "reviewedUnitIds": { "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "object", "additionalProperties": false,
      "required": ["pronunciation", "naturalness", "completeness", "scripture", "voiceIdentity", "synchronization"],
      "properties": {
        "pronunciation": { "const": "approved" },
        "naturalness": { "const": "approved" },
        "completeness": { "const": "approved" },
        "scripture": { "const": "approved" },
        "voiceIdentity": { "const": "approved" },
        "synchronization": { "const": "approved" }
      }
    },
    "issues": { "type": "array", "maxItems": 0 }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
