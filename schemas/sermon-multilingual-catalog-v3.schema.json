{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-multilingual-catalog-v3.schema.json",
  "title": "Layer 4 production multilingual sermon catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "defaultPageId",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sermon-multilingual-catalog-v3"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "defaultPageId": {
      "$ref": "#/$defs/identifier"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 104,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "defaultTargetLocale": {
      "$ref": "#/$defs/locale",
      "description": "Optional legacy catalog hint preserved on incremental publication; per-page defaults remain authoritative."
    }
  },
  "$defs": {
    "displayCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "labels"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sermon-page-display-category-v1"
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "required": [
            "en"
          ],
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "not": {
                  "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"
                }
              }
            ]
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,160}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "releasePath": {
      "type": "string",
      "pattern": "^/releases-v2/[A-Za-z0-9_-]{1,160}/[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*\\.json$"
    },
    "fingerprintBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "pageId",
        "sourceSha256",
        "trackSha256",
        "sourceStartSeconds",
        "sourceEndSeconds",
        "algorithmVersion",
        "captureSeconds",
        "indexSha256",
        "indexUrl"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sermon-audio-fingerprint-binding-v1"
        },
        "pageId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "trackSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceStartSeconds": {
          "type": "number",
          "minimum": 0
        },
        "sourceEndSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "algorithmVersion": {
          "const": "spectral-landmarks-v1"
        },
        "captureSeconds": {
          "const": 10
        },
        "indexSha256": {
          "$ref": "#/$defs/sha256"
        },
        "indexUrl": {
          "type": "string",
          "pattern": "^/fingerprints/[a-f0-9]{16}-landmarks\\.json$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releasePackageUrl",
        "releasePackageJsonSha256",
        "contentStatus",
        "audioStatus",
        "capabilities"
      ],
      "properties": {
        "releasePackageUrl": {
          "$ref": "#/$defs/releasePath"
        },
        "releasePackageJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "contentStatus": {
          "enum": [
            "human_reviewed",
            "machine_reviewed"
          ]
        },
        "audioStatus": {
          "enum": [
            "unavailable",
            "human_reviewed"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "captions",
              "audio",
              "download",
              "alignment"
            ]
          }
        },
        "audioFingerprint": {
          "$ref": "#/$defs/fingerprintBinding"
        },
        "simulationOnly": {
          "type": "boolean",
          "description": "Dev-only test content; production readers exclude true."
        },
        "diagnosticOnly": {
          "type": "boolean",
          "description": "Dev-only test content; production readers exclude true."
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "videoDelivery": [
          "sourceMediaSha256"
        ]
      },
      "required": [
        "id",
        "date",
        "sourceLocale",
        "sourceIdentitySha256",
        "defaultTargetLocale",
        "targets",
        "title"
      ],
      "properties": {
        "displayCategory": { "$ref": "#/$defs/displayCategory" },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "sourceLocale": {
          "const": "en"
        },
        "sourceIdentitySha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceMediaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "mediaType": {
          "enum": [
            "podcast",
            "video"
          ]
        },
        "defaultTargetLocale": {
          "$ref": "#/$defs/locale"
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/locale"
          },
          "additionalProperties": {
            "$ref": "#/$defs/target"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "\\S"
        },
        "videoDelivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "canonicalUrl",
            "storageUrl",
            "sha256",
            "bytes"
          ],
          "properties": {
            "schemaVersion": {
              "const": "sermon-video-delivery-v1"
            },
            "canonicalUrl": {
              "type": "string",
              "pattern": "^/pages/[A-Za-z0-9_-]{1,160}/full-video-browser\\.mp4$"
            },
            "storageUrl": {
              "type": "string",
              "pattern": "^https://storage\\.googleapis\\.com/ai-for-god-sermon-media-(dev|prod)/weekly/[A-Za-z0-9_-]{1,160}/[a-f0-9]{64}\\.mp4$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "simulationOnly": {
          "type": "boolean",
          "description": "Dev-only test content; production readers exclude true."
        },
        "diagnosticOnly": {
          "type": "boolean",
          "description": "Dev-only test content; production readers exclude true."
        }
      }
    }
  },
  "x-contractRevision": 2
}
