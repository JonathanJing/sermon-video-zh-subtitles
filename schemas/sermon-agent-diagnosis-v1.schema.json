{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sermon-agent-diagnosis-v1.schema.json",
  "title": "sermon-agent-diagnosis-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "sermon-agent-diagnosis-v1"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "contextSha256": {
      "$ref": "#/$defs/sha256"
    },
    "snapshotId": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "diagnostic",
        "needs_more_evidence"
      ]
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hypothesisId": {
            "$ref": "#/$defs/identifier"
          },
          "classification": {
            "const": "hypothesis"
          },
          "claim": {
            "$ref": "#/$defs/safeText"
          },
          "reason": {
            "$ref": "#/$defs/safeText"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            },
            "maxItems": 32,
            "minItems": 0,
            "uniqueItems": true
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "confidenceReason": {
            "$ref": "#/$defs/safeText"
          },
          "impact": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "layer1",
                  "layer2",
                  "layer3",
                  "layer4"
                ]
              },
              "blockingScope": {
                "type": "string",
                "enum": [
                  "unknown",
                  "affected_unit",
                  "locale_downstream",
                  "all_locales_downstream"
                ]
              },
              "progressRisk": {
                "type": "string",
                "enum": [
                  "unknown",
                  "possible",
                  "observed"
                ]
              },
              "qualityRisk": {
                "type": "string",
                "enum": [
                  "unknown",
                  "possible",
                  "observed"
                ]
              },
              "costRisk": {
                "type": "string",
                "enum": [
                  "unknown",
                  "possible",
                  "observed"
                ]
              }
            },
            "required": [
              "stage",
              "blockingScope",
              "progressRisk",
              "qualityRisk",
              "costRisk"
            ],
            "additionalProperties": false
          },
          "affectedUnitIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            },
            "maxItems": 32,
            "minItems": 1,
            "uniqueItems": true
          },
          "suggestedRepair": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "none",
                  "inspect_evidence",
                  "reconcile_unknown",
                  "request_engineering_review",
                  "propose_new_revision",
                  "propose_version_revalidation"
                ]
              },
              "unitIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identifier"
                },
                "maxItems": 32,
                "minItems": 0,
                "uniqueItems": true
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identifier"
                },
                "maxItems": 32,
                "minItems": 0,
                "uniqueItems": true
              },
              "requiresDeterministicValidation": {
                "const": true
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/safeText"
                },
                "maxItems": 8,
                "minItems": 1,
                "uniqueItems": true
              },
              "rationale": {
                "$ref": "#/$defs/safeText"
              }
            },
            "required": [
              "action",
              "unitIds",
              "evidenceIds",
              "requiresDeterministicValidation",
              "preconditions",
              "rationale"
            ],
            "additionalProperties": false
          },
          "reproducibility": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unknown",
                  "not_run",
                  "replayable"
                ]
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identifier"
                },
                "maxItems": 32,
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "status",
              "evidenceIds"
            ],
            "additionalProperties": false
          },
          "unknowns": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/safeText"
            },
            "maxItems": 8,
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "hypothesisId",
          "classification",
          "claim",
          "reason",
          "evidenceIds",
          "confidence",
          "confidenceReason",
          "impact",
          "affectedUnitIds",
          "suggestedRepair",
          "reproducibility",
          "unknowns"
        ],
        "additionalProperties": false
      },
      "maxItems": 16,
      "minItems": 0,
      "uniqueItems": true
    },
    "missingDataRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "receipt",
              "version_diff",
              "reproduction",
              "identity"
            ]
          },
          "unitIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            },
            "maxItems": 32,
            "minItems": 1,
            "uniqueItems": true
          },
          "question": {
            "$ref": "#/$defs/safeText"
          }
        },
        "required": [
          "kind",
          "unitIds",
          "question"
        ],
        "additionalProperties": false
      },
      "maxItems": 8,
      "minItems": 0,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safeText"
      },
      "maxItems": 8,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "contextSha256",
    "snapshotId",
    "status",
    "hypotheses",
    "missingDataRequests",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "maxLength": 80
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "unit": {
      "type": "object",
      "properties": {
        "unitId": {
          "$ref": "#/$defs/identifier"
        },
        "unitVersion": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "unitId",
        "unitVersion"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetLocale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "maxLength": 24
        },
        "stage": {
          "type": "string",
          "enum": [
            "layer1",
            "layer2",
            "layer3",
            "layer4"
          ]
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "packageVersion": {
          "$ref": "#/$defs/identifier"
        },
        "planVersion": {
          "$ref": "#/$defs/identifier"
        },
        "policyVersion": {
          "$ref": "#/$defs/identifier"
        },
        "revisionId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceCutoff": {
          "type": "string",
          "format": "date-time",
          "maxLength": 32
        }
      },
      "required": [
        "runId",
        "sourceId",
        "sourceSha256",
        "targetLocale",
        "stage",
        "stateRevision",
        "packageVersion",
        "planVersion",
        "policyVersion",
        "revisionId",
        "evidenceCutoff"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cachedInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "reasoningTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "totalTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "required": [
        "inputTokens",
        "cachedInputTokens",
        "outputTokens",
        "reasoningTokens",
        "totalTokens"
      ],
      "additionalProperties": false
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:https?://|file://|/Users/|/workspace/|sk-[A-Za-z0-9_-]{8,}|Bearer\\s))[\\s\\S]*$"
    }
  }
}
