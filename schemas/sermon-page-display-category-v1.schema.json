{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-page-display-category-v1.schema.json",
  "title": "Localized page display category, presentation metadata only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "labels"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sermon-page-display-category-v1"
    },
    "labels": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "required": [
        "en"
      ],
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48,
        "allOf": [
          {
            "pattern": "\\S"
          },
          {
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"
            }
          }
        ]
      }
    }
  }
}
