{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-english-source-review-v2.schema.json",
  "title": "Human English source review with a scoped Layer 2 candidate override",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "alignedSegmentsSha256", "anchorManifestJsonSha256", "humanApproval", "reviewedBy", "reviewedAt", "reviewedSourceUnitIds", "checks", "layer2CandidateOverride"],
  "properties": {
    "schemaVersion": { "const": "sermon-english-source-review-v2" },
    "alignedSegmentsSha256": { "$ref": "#/$defs/sha256" },
    "anchorManifestJsonSha256": { "$ref": "#/$defs/sha256" },
    "humanApproval": { "const": true },
    "reviewedBy": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewedSourceUnitIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceIdentity", "transcriptCompleteness", "wordAlignment", "sentenceAndPauseBoundaries"],
      "properties": {
        "sourceIdentity": { "const": "approved" },
        "transcriptCompleteness": { "const": "approved" },
        "wordAlignment": { "const": "approved" },
        "sentenceAndPauseBoundaries": { "const": "approved" }
      }
    },
    "layer2CandidateOverride": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "scope", "sourceId", "machineJudge", "acknowledgedFailureSentenceIds", "acknowledgedHighRiskSentenceIds", "acknowledgedAnchorIssueTypes", "targetLocales", "audioGeneration", "publication", "userInstructionItemId", "authorizationItemId", "userStatement"],
      "properties": {
        "decision": { "const": "approved_for_layer2_candidates_despite_machine_rejection" },
        "scope": { "const": "layer2_candidate_only" },
        "sourceId": { "type": "string", "minLength": 1 },
        "machineJudge": { "$ref": "#/$defs/jsonArtifact" },
        "acknowledgedFailureSentenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "acknowledgedHighRiskSentenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "acknowledgedAnchorIssueTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "targetLocales": { "const": ["es", "ko", "zh-Hans"] },
        "audioGeneration": { "const": false },
        "publication": { "const": false },
        "userInstructionItemId": { "type": "string", "minLength": 1 },
        "authorizationItemId": { "type": "string", "minLength": 1 },
        "userStatement": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "jsonArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "jsonSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "jsonSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
