{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-full-video-text-content-v3.schema.json",
  "title": "Full reading content whose text may be machine-checked",
  "type": "object",
  "required": [
    "schemaVersion",
    "pageId",
    "targetLocale",
    "sourceLocale",
    "status",
    "durationSeconds",
    "audioDurationSeconds",
    "reviewMode",
    "cues"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sermon-full-video-text-content-v3"
    },
    "pageId": {
      "type": "string",
      "minLength": 1
    },
    "targetLocale": {
      "type": "string",
      "minLength": 1
    },
    "sourceLocale": {
      "const": "en"
    },
    "status": {
      "enum": [
        "human_reviewed",
        "machine_checked"
      ]
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "description": "Approved source window, used only by full reading cues/source anchors."
    },
    "audioDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "description": "Measured bound track duration, used by spoken captions and playback."
    },
    "reviewMode": {
      "const": "formal"
    },
    "cues": {
      "type": "array",
      "minItems": 1
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "text",
        "english"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "english": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "machine_checked"
          }
        }
      },
      "then": {
        "required": [
          "disclosure"
        ]
      },
      "else": {
        "not": {
          "required": [
            "disclosure"
          ]
        }
      }
    }
  ],
  "description": "Existing content identity, metadata, group and asset binding checks remain mandatory in the producer and readers. Additive migration requires measured audio duration and explicit review mode; never infer duration from the last caption. v3 adds machine_checked: the full text was admitted by a machine quality waiver, not a human review, and the disclosure is required. It is read only through a v4 release whose contentStatus equals this status. Simulation content stays on v2."
}
