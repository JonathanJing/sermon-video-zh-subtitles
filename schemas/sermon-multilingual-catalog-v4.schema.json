{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-multilingual-catalog-v4.schema.json",
  "title": "Layer 4 production multilingual catalog with machine-checked targets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "defaultPageId",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sermon-multilingual-catalog-v4"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "defaultPageId": {
      "$ref": "#/$defs/identifier"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 104,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "defaultTargetLocale": {
      "$ref": "#/$defs/locale",
      "description": "Optional legacy catalog hint preserved on incremental publication; per-page defaults remain authoritative."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,160}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "releasePath": {
      "type": "string",
      "pattern": "^/releases-v[24]/[A-Za-z0-9_-]{1,160}/[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*\\.json$"
    },
    "fingerprintBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "pageId",
        "sourceSha256",
        "trackSha256",
        "sourceStartSeconds",
        "sourceEndSeconds",
        "algorithmVersion",
        "captureSeconds",
        "indexSha256",
        "indexUrl"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sermon-audio-fingerprint-binding-v1"
        },
        "pageId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "trackSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceStartSeconds": {
          "type": "number",
          "minimum": 0
        },
        "sourceEndSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "algorithmVersion": {
          "const": "spectral-landmarks-v1"
        },
        "captureSeconds": {
          "const": 10
        },
        "indexSha256": {
          "$ref": "#/$defs/sha256"
        },
        "indexUrl": {
          "type": "string",
          "pattern": "^/fingerprints/[a-f0-9]{16}-landmarks\\.json$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releasePackageUrl",
        "releasePackageJsonSha256",
        "contentStatus",
        "audioStatus",
        "capabilities"
      ],
      "properties": {
        "releasePackageUrl": {
          "$ref": "#/$defs/releasePath"
        },
        "releasePackageJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "contentStatus": {
          "enum": [
            "human_reviewed",
            "machine_reviewed",
            "machine_checked"
          ]
        },
        "audioStatus": {
          "enum": [
            "unavailable",
            "human_reviewed",
            "machine_checked"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "captions",
              "audio",
              "download",
              "alignment"
            ]
          }
        },
        "audioFingerprint": {
          "$ref": "#/$defs/fingerprintBinding"
        },
        "simulationOnly": {
          "type": "boolean",
          "description": "Dev-only test content; production readers exclude true."
        },
        "diagnosticOnly": {
          "type": "boolean",
          "description": "Dev-only test content; production readers exclude true."
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "contentStatus": {
                    "const": "machine_checked"
                  }
                },
                "required": [
                  "contentStatus"
                ]
              },
              {
                "properties": {
                  "audioStatus": {
                    "const": "machine_checked"
                  }
                },
                "required": [
                  "audioStatus"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "releasePackageUrl": {
                "pattern": "^/releases-v4/"
              }
            }
          },
          "else": {
            "properties": {
              "releasePackageUrl": {
                "pattern": "^/releases-v2/"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "contentStatus": {
                    "const": "machine_checked"
                  }
                },
                "required": [
                  "contentStatus"
                ]
              },
              {
                "properties": {
                  "audioStatus": {
                    "const": "machine_checked"
                  }
                },
                "required": [
                  "audioStatus"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "contentStatus": {
                "enum": [
                  "human_reviewed",
                  "machine_checked"
                ]
              },
              "audioStatus": {
                "enum": [
                  "human_reviewed",
                  "machine_checked"
                ]
              },
              "capabilities": {
                "allOf": [
                  {
                    "contains": {
                      "const": "text"
                    }
                  },
                  {
                    "contains": {
                      "const": "captions"
                    }
                  },
                  {
                    "contains": {
                      "const": "audio"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "videoDelivery": [
          "sourceMediaSha256"
        ]
      },
      "required": [
        "id",
        "date",
        "sourceLocale",
        "sourceIdentitySha256",
        "defaultTargetLocale",
        "targets",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "sourceLocale": {
          "const": "en"
        },
        "sourceIdentitySha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceMediaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "mediaType": {
          "enum": [
            "podcast",
            "video"
          ]
        },
        "defaultTargetLocale": {
          "$ref": "#/$defs/locale"
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/locale"
          },
          "additionalProperties": {
            "$ref": "#/$defs/target"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "\\S"
        },
        "videoDelivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "canonicalUrl",
            "storageUrl",
            "sha256",
            "bytes"
          ],
          "properties": {
            "schemaVersion": {
              "const": "sermon-video-delivery-v1"
            },
            "canonicalUrl": {
              "type": "string",
              "pattern": "^/pages/[A-Za-z0-9_-]{1,160}/full-video-browser\\.mp4$"
            },
            "storageUrl": {
              "type": "string",
              "pattern": "^https://storage\\.googleapis\\.com/ai-for-god-sermon-media-(dev|prod)/weekly/[A-Za-z0-9_-]{1,160}/[a-f0-9]{64}\\.mp4$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "simulationOnly": {
          "type": "boolean",
          "description": "Dev-only test content; production readers exclude true."
        },
        "diagnosticOnly": {
          "type": "boolean",
          "description": "Dev-only test content; production readers exclude true."
        }
      }
    }
  },
  "x-contractRevision": 1,
  "description": "Published at /multilingual-v4.json. Carries human-reviewed targets (v3 releases under /releases-v2/) and machine-checked targets (v4 releases under /releases-v4/). /multilingual-v3.json stays the human-only projection for clients that predate v4."
}
