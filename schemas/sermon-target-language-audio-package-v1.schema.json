{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-target-language-audio-package-v1.schema.json",
  "title": "Layer 3 Target-Language Audio Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "englishSourcePackageJsonSha256", "targetLanguageCandidateJsonSha256", "targetLanguageSpeechJobJsonSha256", "targetLocale", "status", "ratePolicy", "voice", "units", "track", "captions", "schedule", "machineScreening", "humanReview", "issues", "downstreamInvalidationKey"],
  "properties": {
    "schemaVersion": { "const": "sermon-target-language-audio-package-v1" },
    "packageId": { "type": "string", "minLength": 1 },
    "englishSourcePackageJsonSha256": { "$ref": "#/$defs/sha256" },
    "targetLanguageCandidateJsonSha256": { "$ref": "#/$defs/sha256" },
    "targetLanguageSpeechJobJsonSha256": { "$ref": "#/$defs/sha256" },
    "targetLocale": { "$ref": "#/$defs/locale" },
    "status": { "enum": ["audio_unavailable", "candidate", "machine_screened", "human_reviewed", "rejected"] },
    "ratePolicy": { "const": "natural_no_time_stretch" },
    "voice": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "checkpointSha256", "targetLocaleCapability", "authorizationStatus"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "checkpointSha256": { "$ref": "#/$defs/sha256" },
            "targetLocaleCapability": { "enum": ["unverified", "candidate", "reviewed"] },
            "authorizationStatus": { "enum": ["missing", "authorized"] }
          }
        }
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["textGroupId", "targetTextSha256", "audio", "durationSeconds"],
        "properties": {
          "textGroupId": { "type": "string", "minLength": 1 },
          "targetTextSha256": { "$ref": "#/$defs/sha256" },
          "audio": { "$ref": "#/$defs/artifact" },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "track": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
    "captions": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
    "schedule": { "oneOf": [{ "$ref": "#/$defs/jsonArtifact" }, { "type": "null" }] },
    "machineScreening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "model", "coverage"],
      "properties": {
        "status": { "enum": ["not_run", "pass", "requires_review", "fail"] },
        "model": { "type": ["string", "null"] },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "humanApproval", "reviewedBy", "reviewedAt", "fullPlayback"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "humanApproval": { "type": "boolean" },
        "reviewedBy": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"] },
        "fullPlayback": { "enum": ["pending", "approved", "rejected"] }
      }
    },
    "issues": { "type": "array" },
    "downstreamInvalidationKey": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "jsonArtifact": {
      "type": "object",
      "required": ["path", "sha256", "jsonSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "jsonSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
