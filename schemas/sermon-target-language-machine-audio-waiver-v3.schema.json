{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-target-language-machine-audio-waiver-v3.schema.json",
  "title": "Machine quality waiver for one immutable target-language audio package (v3: per-unit human acceptance of audio QC findings)",
  "description": "v3 adds humanAcceptance: a person's acceptance (audio_qc_human_acceptance) of the exact audio of units the audio QC failed; those units are human_accepted while every other unit stays a machine pass. humanApproval stays false and the disclosure stays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewKind",
    "humanApproval",
    "decision",
    "targetLocale",
    "englishSourcePackageJsonSha256",
    "targetLanguageCandidateJsonSha256",
    "targetLanguageAudioPackageJsonSha256",
    "trackSha256",
    "textWaiverJsonSha256",
    "machineScreeningStatus",
    "machineScreeningReceiptJsonSha256",
    "secondaryAsrModel",
    "reviewedUnitIds",
    "unitResults",
    "audioQcJsonSha256",
    "trackCheckJsonSha256",
    "calibration",
    "implementationSha256",
    "rules",
    "disclosure",
    "createdAt",
    "postPublicationSpotCheck",
    "humanAcceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sermon-target-language-machine-audio-waiver-v3"
    },
    "reviewKind": {
      "const": "machine_quality_waiver"
    },
    "humanApproval": {
      "const": false
    },
    "decision": {
      "const": "machine_quality_waived"
    },
    "targetLocale": {
      "enum": [
        "zh-Hans",
        "ko",
        "es"
      ]
    },
    "englishSourcePackageJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "targetLanguageCandidateJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "targetLanguageAudioPackageJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "trackSha256": {
      "$ref": "#/$defs/sha256"
    },
    "textWaiverJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "machineScreeningStatus": {
      "enum": [
        "pass",
        "requires_review"
      ]
    },
    "machineScreeningReceiptJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "secondaryAsrModel": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "modelRevision"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "modelRevision": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      ]
    },
    "reviewedUnitIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unitResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "textGroupId",
          "audioSha256",
          "status",
          "asr",
          "primarySimilarity",
          "secondarySimilarity",
          "failedAttempts",
          "secondaryAsrModel"
        ],
        "properties": {
          "textGroupId": {
            "type": "string",
            "minLength": 1
          },
          "audioSha256": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "enum": [
              "pass",
              "human_accepted"
            ]
          },
          "asr": {
            "enum": [
              "primary_pass",
              "secondary_pass",
              "human_accepted"
            ]
          },
          "primarySimilarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "secondarySimilarity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "failedAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "secondaryAsrModel": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "modelRevision"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "modelRevision": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "audioQcJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "trackCheckJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    },
    "implementationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "disclosure": {
      "$ref": "#/$defs/disclosure"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "postPublicationSpotCheck": {
      "const": "owner_spot_check_after_release"
    },
    "humanAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jsonSha256",
        "decidedBy",
        "decidedAt",
        "userStatement",
        "audioQcJsonSha256",
        "groupIds",
        "groupDecisions"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sermon-audio-qc-human-acceptance-v1"
        },
        "jsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "decidedBy": {
          "type": "string",
          "minLength": 1
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "userStatement": {
          "type": "string",
          "minLength": 1
        },
        "groupIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groupDecisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groupId",
              "decidedBy",
              "decidedByRole"
            ],
            "properties": {
              "groupId": {
                "type": "string",
                "minLength": 1
              },
              "decidedBy": {
                "type": "string",
                "minLength": 1
              },
              "decidedByRole": {
                "enum": [
                  "human_operator",
                  "delegated_agent"
                ]
              }
            }
          }
        },
        "audioQcJsonSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonSha256",
        "implementationSha256",
        "semanticChecksIncluded",
        "overallDetectionRate",
        "minimumKindDetectionRate",
        "cleanFalsePositiveRate",
        "runtimeIdentitySha256"
      ],
      "properties": {
        "jsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "implementationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "semanticChecksIncluded": {
          "const": true
        },
        "overallDetectionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumKindDetectionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cleanFalsePositiveRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "runtimeIdentitySha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRepairAttemptsPerSentence",
        "calibration"
      ],
      "properties": {
        "maxRepairAttemptsPerSentence": {
          "const": 4
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overallDetectionRate",
            "perKindDetectionRate",
            "maxCleanFalsePositiveRate"
          ],
          "properties": {
            "overallDetectionRate": {
              "type": "number"
            },
            "perKindDetectionRate": {
              "type": "number"
            },
            "maxCleanFalsePositiveRate": {
              "type": "number"
            }
          }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "text",
        "english"
      ],
      "properties": {
        "locale": {
          "enum": [
            "zh-Hans",
            "ko",
            "es"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "english": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
