{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-human-anchor-exception-receipt-v2.schema.json",
  "title": "Locale-bound human acceptance of one complete scripture anchor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "humanApproval", "reviewedBy", "reviewedAt", "userDecision", "reason", "targetLocale", "englishSourcePackage", "anchorManifest", "candidate", "acceptedIssue"],
  "properties": {
    "schemaVersion": {"const": "sermon-human-anchor-exception-receipt-v2"},
    "status": {"const": "approved"},
    "humanApproval": {"const": true},
    "reviewedBy": {"type": "string", "minLength": 1},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "userDecision": {"const": "授权本次例外，立即发布该语言"},
    "reason": {"const": "preserve_complete_scripture_sentence"},
    "targetLocale": {"enum": ["zh-Hans", "ko", "es"]},
    "englishSourcePackage": {"$ref": "#/$defs/fileBinding"},
    "anchorManifest": {"$ref": "#/$defs/fileBinding"},
    "candidate": {"$ref": "#/$defs/fileBinding"},
    "acceptedIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sourceSentenceId", "durationSeconds", "maximumSeconds", "sourceWordIds", "english"],
      "properties": {
        "type": {"const": "clause_unit_exceeds_target_without_safe_boundary"},
        "sourceSentenceId": {"const": "0-s202"},
        "durationSeconds": {"const": 9.199951},
        "maximumSeconds": {"const": 8.0},
        "sourceWordIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "english": {"const": "‘Don’t harm the earth or the sea or the trees until we seal the servants of our God on their foreheads.’"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "jsonSha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "jsonSha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
