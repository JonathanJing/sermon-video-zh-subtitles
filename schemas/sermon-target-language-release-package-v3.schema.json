{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-target-language-release-package-v3.schema.json",
  "title": "Layer 4 reviewed text, audio, outline and meditation release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "pageId",
    "sourceLocale",
    "targetLocale",
    "targetLanguageCandidateJsonSha256",
    "spokenTargetLanguageCandidateJsonSha256",
    "targetLanguageAudioPackageJsonSha256",
    "status",
    "contentStatus",
    "audioStatus",
    "interfaceLocale",
    "contentLocale",
    "audioLocale",
    "assets",
    "httpVerification",
    "deviceAcceptance",
    "venueAcceptance",
    "issues",
    "englishSourcePackageJsonSha256",
    "sourceIdentity",
    "fourProducts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sermon-target-language-release-package-v3"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "pageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,159}$"
    },
    "sourceLocale": {
      "const": "en"
    },
    "targetLocale": {
      "$ref": "#/$defs/locale"
    },
    "targetLanguageCandidateJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "targetLanguageAudioPackageJsonSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "published_http_verified",
        "withdrawn"
      ]
    },
    "contentStatus": {
      "enum": [
        "draft",
        "machine_reviewed",
        "human_reviewed"
      ]
    },
    "audioStatus": {
      "enum": [
        "unavailable",
        "candidate",
        "human_reviewed"
      ]
    },
    "interfaceLocale": {
      "$ref": "#/$defs/locale"
    },
    "contentLocale": {
      "$ref": "#/$defs/locale"
    },
    "audioLocale": {
      "oneOf": [
        {
          "$ref": "#/$defs/locale"
        },
        {
          "type": "null"
        }
      ]
    },
    "assets": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "page",
              "content",
              "audio",
              "captions",
              "outline",
              "meditation",
              "product_manifest"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/[^/].*"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "maxItems": 7,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "page"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "content"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "audio"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "captions"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "outline"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "meditation"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "product_manifest"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "httpVerification": {
      "$ref": "#/$defs/acceptance"
    },
    "deviceAcceptance": {
      "$ref": "#/$defs/acceptance"
    },
    "venueAcceptance": {
      "$ref": "#/$defs/acceptance"
    },
    "issues": {
      "type": "array"
    },
    "spokenTargetLanguageCandidateJsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "englishSourcePackageJsonSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceUrlHash",
        "mediaSha256",
        "durationSeconds",
        "window"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrlHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startSeconds",
            "endSeconds",
            "approvalReceiptSha256"
          ],
          "properties": {
            "startSeconds": {
              "type": "number",
              "minimum": 0
            },
            "endSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "approvalReceiptSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "fourProducts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePackageSha256",
        "textCandidateSha256",
        "audioPackageSha256",
        "outlineArtifactSha256",
        "meditationArtifactSha256",
        "outlineReviewSha256",
        "meditationReviewSha256",
        "metadataApprovalSha256",
        "contentSha256",
        "candidateSha256"
      ],
      "properties": {
        "sourcePackageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "textCandidateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audioPackageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outlineArtifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "meditationArtifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outlineReviewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "meditationReviewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadataApprovalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidenceSha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "pass",
            "fail"
          ]
        },
        "evidenceSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
