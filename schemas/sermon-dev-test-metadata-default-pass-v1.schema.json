{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-dev-test-metadata-default-pass-v1.schema.json",
  "title": "Display metadata of an isolated Dev test page under an explicit default-pass authorization; never a human approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pageId",
    "date",
    "proposalFileSha256",
    "decision",
    "reviewer",
    "humanApproval",
    "defaultPassStatement",
    "recordedAt",
    "approvedLocales",
    "locales",
    "releaseIntent"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sermon-dev-test-metadata-default-pass-v1"
    },
    "pageId": {
      "type": "string",
      "pattern": "^mockup-[A-Za-z0-9][A-Za-z0-9_-]{0,139}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "proposalFileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "const": "test_default_pass"
    },
    "reviewer": {
      "const": "test-default-pass-not-human"
    },
    "humanApproval": {
      "const": false
    },
    "defaultPassStatement": {
      "type": "string",
      "minLength": 1,
      "pattern": "not a human review"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvedLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "zh-Hans",
          "ko",
          "es"
        ]
      }
    },
    "locales": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "zh-Hans",
          "ko",
          "es"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/fields"
      }
    },
    "releaseIntent": {
      "const": {
        "schemaVersion": "sermon-release-intent-v1",
        "environment": "dev",
        "channel": "dev",
        "project": "ai-for-god-sermon-audio-dev",
        "site": "ai-for-god-sermon-audio-dev",
        "origin": "https://ai-for-god-sermon-audio-dev.web.app"
      }
    }
  },
  "$defs": {
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series",
        "title",
        "speaker",
        "scripture",
        "summary",
        "outline"
      ],
      "properties": {
        "series": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "scripture": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
