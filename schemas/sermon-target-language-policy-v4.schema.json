{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-target-language-policy-v4.schema.json",
  "title": "Source-scoped target-language policy with direct human term receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceLocale", "targetLocale", "translator", "reviewer", "terminology", "scripture", "languageReview", "formatting", "batching", "sourceScope", "componentSha256"],
  "properties": {
    "schemaVersion": {"const": "sermon-target-language-policy-v4"},
    "sourceLocale": {"const": "en"},
    "targetLocale": {"type": "string", "pattern": "^(?!en(?:-|$))[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "sourceScope": {
      "type": "object", "additionalProperties": false,
      "required": ["englishSourcePackageJsonSha256", "anchorManifestSha256", "usedSeriesNames", "usedProperNames", "ordinaryPhraseExclusions", "termApprovalEvidence", "termApprovalReceipt"],
      "properties": {
        "englishSourcePackageJsonSha256": {"$ref": "#/$defs/sha256"},
        "anchorManifestSha256": {"$ref": "#/$defs/sha256"},
        "usedSeriesNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "usedProperNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ordinaryPhraseExclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "termApprovalEvidence": {"type": "array", "maxItems": 0},
        "termApprovalReceipt": {
          "type": "object", "additionalProperties": false,
          "required": ["schemaVersion", "targetLocale", "englishSourcePackageJsonSha256", "anchorManifestSha256", "decision", "humanApproval", "reviewedBy", "reviewedAt", "userStatement", "approvedTerms", "excludedScannerPhrases"],
          "properties": {
            "schemaVersion": {"const": "sermon-source-scoped-term-approval-v1"},
            "targetLocale": {"type": "string", "minLength": 2},
            "englishSourcePackageJsonSha256": {"$ref": "#/$defs/sha256"},
            "anchorManifestSha256": {"$ref": "#/$defs/sha256"},
            "decision": {"const": "approved"},
            "humanApproval": {"const": true},
            "reviewedBy": {"type": "string", "minLength": 1},
            "reviewedAt": {"type": "string", "format": "date-time"},
            "userStatement": {"type": "string", "minLength": 1},
            "approvedTerms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/approvedTerm"}},
            "excludedScannerPhrases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "translator": {"$ref": "#/$defs/modelStage"},
    "reviewer": {"$ref": "#/$defs/modelStage"},
    "terminology": {
      "type": "object", "additionalProperties": false,
      "required": ["seriesTableSha256", "seriesNames", "properNames"],
      "properties": {
        "seriesTableSha256": {"$ref": "#/$defs/sha256"},
        "seriesNames": {"type": "array", "items": {"$ref": "#/$defs/term"}},
        "properNames": {"type": "array", "items": {"$ref": "#/$defs/term"}}
      }
    },
    "scripture": {
      "type": "object", "additionalProperties": false,
      "required": ["editionId", "citationUseStatus", "quoteCheckPolicy", "referenceStyle"],
      "properties": {
        "editionId": {"type": ["string", "null"], "minLength": 1},
        "citationUseStatus": {"enum": ["pending", "project_source_reviewed"]},
        "quoteCheckPolicy": {"enum": ["pending", "source_bound_exact_quote", "references_only"]},
        "referenceStyle": {"type": "string", "minLength": 1}
      }
    },
    "languageReview": {
      "type": "object", "additionalProperties": false,
      "required": ["pluginId", "pluginImplementationSha256", "implementationStatus", "requiredChecks", "registerRules"],
      "properties": {
        "pluginId": {"type": "string", "minLength": 1},
        "pluginImplementationSha256": {"$ref": "#/$defs/sha256"},
        "implementationStatus": {"enum": ["pending", "verified"]},
        "requiredChecks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "registerRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "formatting": {
      "type": "object", "additionalProperties": false,
      "required": ["speechRegister", "punctuationRules", "segmentationRules"],
      "properties": {
        "speechRegister": {"type": "string", "minLength": 1},
        "punctuationRules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "segmentationRules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "batching": {
      "type": "object", "additionalProperties": false,
      "required": ["batchSize", "workers"],
      "properties": {
        "batchSize": {"type": "integer", "minimum": 1, "maximum": 100},
        "workers": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "componentSha256": {
      "type": "object", "additionalProperties": false,
      "required": ["translator", "reviewer", "terminology", "scripture", "languageReview", "formatting", "batching", "sourceScope"],
      "properties": {
        "translator": {"$ref": "#/$defs/sha256"}, "reviewer": {"$ref": "#/$defs/sha256"},
        "terminology": {"$ref": "#/$defs/sha256"}, "scripture": {"$ref": "#/$defs/sha256"},
        "languageReview": {"$ref": "#/$defs/sha256"}, "formatting": {"$ref": "#/$defs/sha256"},
        "batching": {"$ref": "#/$defs/sha256"}, "sourceScope": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "modelStage": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "reasoningEffort", "promptVersion"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "reasoningEffort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]},
        "promptVersion": {"type": "string", "minLength": 1}
      }
    },
    "term": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "target", "reviewStatus"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": ["string", "null"], "minLength": 1},
        "reviewStatus": {"enum": ["pending", "project_established", "human_reviewed"]}
      }
    },
    "approvedTerm": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "target", "sourceUnitId"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "sourceUnitId": {"type": "string", "minLength": 1}
      }
    }
  }
}
