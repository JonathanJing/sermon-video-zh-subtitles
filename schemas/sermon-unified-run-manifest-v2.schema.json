{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-unified-run-manifest-v2.schema.json",
  "title": "Executable unified production manifest",
  "description": "Version 2 adds hash-bound local bindings, typed adapters and an explicit dated execution window. Version 1 remains read-only for planning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productionRunId",
    "runRevision",
    "jobRoot",
    "content",
    "source",
    "locales",
    "canaryScope",
    "finalScope",
    "activeScope",
    "policies",
    "budget",
    "executionAdmission",
    "bindings",
    "steps",
    "executionWindow",
    "transport"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sermon-unified-run-manifest-v2"
    },
    "productionRunId": {
      "type": "string",
      "minLength": 1
    },
    "runRevision": {
      "type": "integer",
      "minimum": 1
    },
    "jobRoot": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "locales": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/targetLocale"
      }
    },
    "canaryScope": {
      "$ref": "#/$defs/completionScope"
    },
    "finalScope": {
      "const": "dual_production_verified"
    },
    "activeScope": {
      "$ref": "#/$defs/completionScope"
    },
    "policies": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "executionAdmission": {
      "$ref": "#/$defs/executionAdmission"
    },
    "transport": {
      "enum": [
        "fixture",
        "provider"
      ]
    },
    "fixtureSetId": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "planHash": {
      "$ref": "#/$defs/sha256"
    },
    "manifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,100}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "executionWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "startsAt",
        "deadlineAt"
      ],
      "properties": {
        "timezone": {
          "const": "America/Los_Angeles"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "deadlineAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stageId",
          "adapter",
          "dependsOn",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,100}$"
          },
          "stageId": {
            "enum": [
              "media_verify",
              "window_review",
              "asr",
              "english_source",
              "layer2_admit",
              "layer2_group",
              "translation_review",
              "layer3_prepare",
              "layer3_unit",
              "layer3_screen",
              "listen_review",
              "study_product",
              "publish_endpoint"
            ]
          },
          "adapter": {
            "enum": [
              "media.verify",
              "canonical.inspect",
              "canonical.layer2",
              "app.prepare",
              "fixture.replay",
              "review.gate",
              "canonical.audio",
              "app.delivery",
              "source.prepare",
              "study.produce"
            ]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "$ref": "#/$defs/completionScope"
          },
          "locale": {
            "$ref": "#/$defs/targetLocale"
          },
          "configuration": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "reviewKind": {
            "enum": [
              "window",
              "english",
              "translation",
              "audio",
              "outline",
              "reflection",
              "endpoint"
            ]
          },
          "maxCostMicroUsd": {
            "type": "integer",
            "minimum": 0
          },
          "timeoutSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 86400
          },
          "budgetAuthorization": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetLocale": {
      "type": "string",
      "pattern": "^(?!en(?:-|$))[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "completionScope": {
      "enum": [
        "media_verified",
        "english_ready_for_translation",
        "layer2_machine_candidate",
        "translation_approved",
        "audio_screened",
        "listen_approved",
        "study_approved",
        "dev_reader_verified",
        "dual_test_end_approved",
        "dual_production_verified"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentId",
        "pageId",
        "category",
        "sourceDate"
      ],
      "properties": {
        "contentId": {
          "type": "string",
          "minLength": 1
        },
        "pageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,160}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "sourceDate": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "weeklyScheduleDate": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "mediaSha256",
        "window"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrlHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "mediaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "durationSeconds": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startSeconds",
            "endSeconds",
            "timeBase"
          ],
          "properties": {
            "startSeconds": {
              "type": "number",
              "minimum": 0
            },
            "endSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "timeBase": {
              "const": "source_media"
            },
            "approvalReceiptSha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "policySha256",
        "promptSha256",
        "pluginSha256"
      ],
      "properties": {
        "locale": {
          "$ref": "#/$defs/targetLocale"
        },
        "policySha256": {
          "$ref": "#/$defs/sha256"
        },
        "promptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "pluginSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "limitMicroUsd"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "limitMicroUsd": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reservationId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "executionAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closureSha256",
        "modules"
      ],
      "properties": {
        "closureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtimeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "tempPathSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
