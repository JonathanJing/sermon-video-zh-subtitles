{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-unified-continuation-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "sermon-unified-continuation-receipt-v1"
    },
    "recipeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stageId": {
      "type": "string"
    },
    "runKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "productionRunId": {
      "type": "string"
    },
    "priorPlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fromRunRevision": {
      "type": "integer",
      "minimum": 1
    },
    "toRunRevision": {
      "type": "integer",
      "minimum": 2
    },
    "ports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "jsonSha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "jsonSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "configurations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "jsonSha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "jsonSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "jsonSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "jsonSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "humanApprovalCreated": {
      "const": false
    },
    "modelDispatches": {
      "const": 0
    }
  },
  "required": [
    "schemaVersion",
    "recipeSha256",
    "stageId",
    "runKey",
    "productionRunId",
    "priorPlanHash",
    "fromRunRevision",
    "toRunRevision",
    "ports",
    "evidence",
    "configurations",
    "manifest",
    "humanApprovalCreated",
    "modelDispatches"
  ]
}
