{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-podcast-dual-worker-manifest-v1.schema.json",
  "title": "Podcast dual-speaker target-language render manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "targetLocale", "status", "sourcePackageJsonSha256", "anchorManifestJsonSha256", "candidateJsonSha256", "speechJobJsonSha256", "speakerRouteFileSha256", "runtime", "workerPlan", "units"],
  "properties": {
    "schemaVersion": { "const": "sermon-podcast-dual-worker-render-manifest-v1" },
    "sourceId": { "type": "string", "minLength": 1 },
    "targetLocale": { "type": "string", "minLength": 2 },
    "status": { "enum": ["prepared", "rendering", "candidate", "failed"] },
    "sourcePackageJsonSha256": { "$ref": "#/$defs/sha256" },
    "anchorManifestJsonSha256": { "$ref": "#/$defs/sha256" },
    "candidateJsonSha256": { "$ref": "#/$defs/sha256" },
    "speechJobJsonSha256": { "$ref": "#/$defs/sha256" },
    "speakerRouteFileSha256": { "$ref": "#/$defs/sha256" },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "device", "dtype", "implementationSha256", "ratePolicy"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "dtype": { "enum": ["bfloat16", "float32"] },
        "implementationSha256": { "$ref": "#/$defs/sha256" },
        "ratePolicy": { "const": "natural_no_time_stretch" }
      }
    },
    "workerPlan": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workerId", "speakerId", "speakerKey", "checkpointRef", "checkpointSha256", "adapterJsonSha256", "authorizationJsonSha256", "batchSize"],
        "properties": {
          "workerId": { "type": "string", "minLength": 1 },
          "speakerId": { "type": "string", "minLength": 1 },
          "speakerKey": { "type": "string", "minLength": 1 },
          "checkpointRef": { "type": "string", "minLength": 1 },
          "checkpointSha256": { "$ref": "#/$defs/sha256" },
          "adapterJsonSha256": { "$ref": "#/$defs/sha256" },
          "authorizationJsonSha256": { "$ref": "#/$defs/sha256" },
          "batchSize": { "const": 8 }
        }
      }
    },
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unitIndex", "translationGroupId", "sourceUnitIds", "workerId", "speakerId", "checkpointSha256", "textSha256", "seed", "status"],
        "properties": {
          "unitIndex": { "type": "integer", "minimum": 0 },
          "translationGroupId": { "type": "string", "minLength": 1 },
          "sourceUnitIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "workerId": { "type": "string", "minLength": 1 },
          "speakerId": { "type": "string", "minLength": 1 },
          "checkpointSha256": { "$ref": "#/$defs/sha256" },
          "textSha256": { "$ref": "#/$defs/sha256" },
          "seed": { "type": "integer", "minimum": 0 },
          "audio": { "$ref": "#/$defs/artifact" },
          "receipt": { "$ref": "#/$defs/jsonArtifact" },
          "status": { "enum": ["pending", "rendered", "failed"] }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "jsonArtifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "jsonSha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "jsonSha256": { "$ref": "#/$defs/sha256" } } }
  }
}
