{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-english-source-review-v1.schema.json",
  "title": "Human review bound to one English Source Package input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "alignedSegmentsSha256", "anchorManifestJsonSha256", "humanApproval", "reviewedBy", "reviewedAt", "reviewedSourceUnitIds", "checks"],
  "properties": {
    "schemaVersion": { "const": "sermon-english-source-review-v1" },
    "alignedSegmentsSha256": { "$ref": "#/$defs/sha256" },
    "anchorManifestJsonSha256": { "$ref": "#/$defs/sha256" },
    "humanApproval": { "const": true },
    "reviewedBy": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewedSourceUnitIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIdentity", "transcriptCompleteness", "wordAlignment", "sentenceAndPauseBoundaries"],
      "properties": {
        "sourceIdentity": { "const": "approved" },
        "transcriptCompleteness": { "const": "approved" },
        "wordAlignment": { "const": "approved" },
        "sentenceAndPauseBoundaries": { "const": "approved" }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
