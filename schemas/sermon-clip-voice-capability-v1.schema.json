{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/sermon-clip-voice-capability-v1.schema.json",
  "title": "Clip-scoped voice short and long probe admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "englishSourcePackageJsonSha256", "targetLocale", "speakerId", "checkpointSha256", "shortDemoApproval", "shortDemoAudio", "longProbeApproval", "longProbeManifest", "longProbeAudio"],
  "properties": {
    "schemaVersion": {"const": "sermon-clip-voice-capability-v1"},
    "scope": {"const": "this_clip_locale_probe_capability_only"},
    "englishSourcePackageJsonSha256": {"$ref": "#/$defs/sha256"},
    "targetLocale": {"type": "string", "pattern": "^(?!en(?:-|$))[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "speakerId": {"type": "string", "minLength": 1},
    "checkpointSha256": {"$ref": "#/$defs/sha256"},
    "shortDemoApproval": {"$ref": "#/$defs/jsonArtifact"},
    "shortDemoAudio": {"$ref": "#/$defs/artifact"},
    "longProbeApproval": {"$ref": "#/$defs/jsonArtifact"},
    "longProbeManifest": {"$ref": "#/$defs/jsonArtifact"},
    "longProbeAudio": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "jsonArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "jsonSha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "jsonSha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
